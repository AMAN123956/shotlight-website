---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { BUY_ME_A_COFFEE } from '../lib/links';
// Preload the faces used above the fold, so the headline doesn't reflow (and shift the hero) when fonts arrive.
import sans400 from '@fontsource/geist-sans/files/geist-sans-latin-400-normal.woff2?url';
import sans600 from '@fontsource/geist-sans/files/geist-sans-latin-600-normal.woff2?url';
import mono400 from '@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';
import mono500 from '@fontsource/geist-mono/files/geist-mono-latin-500-normal.woff2?url';
const preloads = [sans400, sans600, mono400, mono500];

interface Props {
  title?: string;
  description?: string;
  /** Path of the page, for the canonical URL. Defaults to the current path. */
  path?: string;
  noindex?: boolean;
}

const DEFAULT_DESCRIPTION =
  'Shotlight names every screenshot the moment you take it, finds any of them by the words inside, files them by your rules and clears out duplicates. On-device, free, for Mac.';
const { title, description = DEFAULT_DESCRIPTION, path = Astro.url.pathname, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · Shotlight` : 'Shotlight · Your screenshots, finally findable';
const site = Astro.site ?? new URL('https://www.shotlight.lol');
// Pages build as /name.html (build.format 'file') but are served as /name, so drop the extension.
const clean = path.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(clean, site).href;
const ogImage = new URL('/og.png', site).href;
const here = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const nav = [
  ['/#name', 'Naming'],
  ['/#find', 'Search'],
  ['/#organize', 'Organize'],
  ['/#protect', 'Privacy'],
  ['/#pricing', 'Pricing'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <meta name="theme-color" content="#0A0A0C" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shotlight" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Shotlight: Your screenshots, finally findable." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a href="/" class="brand" aria-label="Shotlight home">
          <Logo />
          <b>Shotlight</b>
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
        <a href="/download" class="btn btn-beam btn-md" data-track="cta_download_header" aria-current={here === '/download' ? 'page' : undefined}>Download free</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-cta">
        <p>Shotlight is free. If it helps you, leave a like or buy me a coffee.</p>
        <div class="cta-actions">
          <button type="button" class="btn btn-ghost btn-md like" data-like aria-pressed="false" hidden>
            <span class="heart" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.3 4.5 6.8 4.5c2 0 3.6 1.1 5.2 3 1.6-1.9 3.2-3 5.2-3 3.5 0 5.4 3.5 4.1 6.8-1.8 4.6-9.3 9.2-9.3 9.2z" /></svg>
            </span>
            <span data-like-label aria-hidden="true">Like</span>
            <span class="like-count mono" aria-hidden="true"><span data-like-count>0</span></span>
          </button>
          <a class="btn btn-ghost btn-md coffee" href={BUY_ME_A_COFFEE} data-track="footer_coffee">
            <svg class="cup" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path class="steam" d="M8.5 2.5c-.7.9-.7 2.1 0 3M12.5 2.5c-.7.9-.7 2.1 0 3" />
              <path d="M4 9h12v4.5A5.5 5.5 0 0 1 10.5 19h-1A5.5 5.5 0 0 1 4 13.5V9z" />
              <path d="M16 10.5h1.5a2.75 2.75 0 0 1 0 5.5H15.6" />
            </svg>
            Buy me a coffee
          </a>
        </div>
      </div>
      <div class="wrap footer-row">
        <span>© 2026 Shotlight. Made for Mac.</span>
        <nav class="nav" aria-label="Footer">
          <a href="/privacy" aria-current={here === '/privacy' ? 'page' : undefined}>Privacy</a>
          <a href="/verify" aria-current={here === '/verify' ? 'page' : undefined}>Verify</a>
          <a href="/support" aria-current={here === '/support' ? 'page' : undefined}>Support</a>
          <a href="/changelog" aria-current={here === '/changelog' ? 'page' : undefined}>Changelog</a>
        </nav>
      </div>
    </footer>
    <script>
      import { initAnalytics } from '../lib/analytics';
      import { initLike } from '../lib/like';
      initAnalytics();
      initLike();
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: rgba(10, 10, 12, 0.78);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line-soft);
  }
  .header-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 14px; padding-bottom: 14px; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; border-radius: 8px; }
  .brand b { font-size: 17px; letter-spacing: -0.01em; }
  .nav { display: flex; gap: 26px; font-size: 14px; flex-wrap: wrap; }
  .nav a { color: var(--text-2); text-decoration: none; border-radius: 4px; transition: color 120ms ease-out; }
  .nav a:hover, .nav a[aria-current='page'] { color: var(--text); }
  @media (max-width: 760px) {
    .header-row .nav { display: none; }
  }
  .site-footer { border-top: 1px solid var(--line-soft); }
  .footer-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; padding-top: 32px; padding-bottom: 32px; font-size: 13px; color: var(--text-3); }
  .footer-row .nav { gap: 20px; font-size: 13px; }

  /* Like + coffee */
  .footer-cta {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px;
    padding-top: 28px; padding-bottom: 28px; border-bottom: 1px solid var(--line-soft);
  }
  .footer-cta p { font-size: 14px; color: var(--text-2); text-wrap: balance; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .like, .coffee { gap: 8px; font-size: 13px; color: var(--text-soft); }
  .like:hover, .coffee:hover { color: var(--text); }

  .like[hidden] { display: none; }
  .like { opacity: 0; transition: opacity 240ms ease-out, transform 120ms ease-out, filter 120ms ease-out, border-color 120ms ease-out, background-color 160ms ease-out; }
  .like.is-in { opacity: 1; }
  .heart { position: relative; display: grid; place-items: center; }
  .heart svg { fill: transparent; stroke: var(--text-2); stroke-width: 1.8; stroke-linejoin: round; transition: fill 160ms ease-out, stroke 160ms ease-out; }
  .like:hover .heart svg { stroke: var(--text); }
  .heart::after {
    content: ''; position: absolute; inset: -6px; border-radius: 50%;
    border: 1.5px solid var(--beam); opacity: 0; pointer-events: none;
  }
  .like-count {
    display: inline-block; overflow: hidden; min-width: 1ch; padding-left: 9px; margin-left: 1px;
    border-left: 1px solid var(--line); color: var(--text-2); font-size: 12px; line-height: 18px;
  }
  .like-count > span { display: inline-block; }

  .like[aria-pressed='true'] { border-color: rgba(212, 255, 63, 0.35); background: rgba(212, 255, 63, 0.06); }
  .like[aria-pressed='true'] .heart svg { fill: var(--beam); stroke: var(--beam); }
  .like[aria-pressed='true'] .like-count { color: var(--beam); border-color: rgba(212, 255, 63, 0.3); }

  .like.is-pop .heart svg { animation: heartpop 380ms cubic-bezier(0.3, 1.6, 0.5, 1); }
  .like.is-pop .heart::after { animation: heartring 480ms ease-out; }
  .like-count.is-up > span { animation: countup 260ms ease-out; }
  .like-count.is-down > span { animation: countdown 260ms ease-out; }
  @keyframes heartpop { 0% { transform: scale(0.7); } 55% { transform: scale(1.28); } 100% { transform: scale(1); } }
  @keyframes heartring { 0% { transform: scale(0.4); opacity: 0.7; } 100% { transform: scale(1.5); opacity: 0; } }
  @keyframes countup { from { transform: translateY(70%); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes countdown { from { transform: translateY(-70%); opacity: 0; } to { transform: none; opacity: 1; } }

  .cup { fill: none; stroke: var(--text-2); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: stroke 120ms ease-out; }
  .coffee:hover .cup { stroke: var(--text); }
  .cup .steam { opacity: 0.55; }
  .coffee:hover .steam { animation: steam 1.2s ease-in-out infinite; }
  @keyframes steam { 0%, 100% { transform: translateY(0); opacity: 0.55; } 50% { transform: translateY(-1.5px); opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .like, .heart svg, .cup { transition: none; }
    .like.is-pop .heart svg, .like.is-pop .heart::after, .like-count > span, .coffee:hover .steam { animation: none !important; }
  }
</style>
