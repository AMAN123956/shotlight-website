---
import Icon from '../Icon.astro';
// Wording note (owner's decision, 2026-11-15): the app isn't sandboxed, so macOS enforces nothing. The claim is
// "no networking code", and /verify shows how to check it. Don't bring back "no network permission".
// The "0 B" strip is an illustration of that claim, not a live counter.
const rows: [string, string, string][] = [
  ['Screenshots leave your Mac', 'Never', 'Often'],
  ['Account required', 'No', 'Often'],
  ['Works offline', 'Fully', 'Varies'],
  ['Flags secrets in captures', 'Yes', 'Rarely'],
];
const checks = [
  'No account and no analytics in the app',
  'Reads only the folders you pick',
  'Secrets are blanked before naming or search',
];
---
<section id="private" class="sec-s wrap" data-section="privacy">
  <div class="pv">
    <div class="glow" aria-hidden="true"></div>

    <div class="left">
      <span class="dpill"><i></i>Private by construction</span>
      <h2>Your screenshots <span class="serif">never leave</span> your Mac.</h2>
      <p class="lead">Shotlight reads them with Apple's on-device tools and has no networking code at all. <a href="/verify" data-track="privacy_verify">Check it yourself</a>.</p>
      <ul class="checks">
        {checks.map((c) => <li><span class="ck"><Icon name="check" class="ic" /></span>{c}</li>)}
      </ul>
      <a class="pv-link" href="/privacy" data-track="privacy_page">Read the privacy page<Icon name="arrow" class="ic ic-sm" /></a>
    </div>

    <div class="right">
      <div class="zero">
        <span class="wf"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 9a15 15 0 0 1 20 0M5.5 12.5a10 10 0 0 1 13 0M9 16a5 5 0 0 1 6 0M12 20h.01"></path></svg></span>
        <div class="zt"><b>Wi‑Fi off</b><small>Everything still works</small></div>
        <div class="zn"><span class="mono">0<em>B</em></span><small>sent by Shotlight</small></div>
      </div>

      <div class="cmpwrap">
        <div class="cmpx" role="table" aria-label="Shotlight compared with cloud screenshot apps">
          <div class="hl" aria-hidden="true"></div>
          <div class="row-c" role="row">
            <div class="c h" role="columnheader"><span class="sr-only">Feature</span></div>
            <div class="c h us" role="columnheader">Shotlight</div>
            <div class="c h them" role="columnheader">Cloud apps</div>
          </div>
          {rows.map(([label, us, them]) => (
            <div class="row-c" role="row">
              <div class="c lab" role="rowheader">{label}</div>
              <div class="c us" role="cell"><Icon name="check" class="ic" />{us}</div>
              <div class="c them" role="cell"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12"></path></svg>{them}</div>
            </div>
          ))}
        </div>
        <p class="foot">General comparison. Individual apps differ.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .pv {
    position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 48px; align-items: center;
    padding: 48px 52px; border-radius: 36px; color: var(--app-text);
    background: linear-gradient(180deg, #131317, #0C0C0F); border: 1px solid #23232b; box-shadow: 0 30px 70px rgba(10, 10, 12, 0.26);
  }
  .glow { position: absolute; width: 520px; height: 360px; right: -140px; top: -160px; border-radius: 50%; background: rgba(212, 255, 63, 0.15); filter: blur(100px); pointer-events: none; }
  .pv > :not(.glow) { position: relative; }
  .dpill { display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 14px 0 10px; border-radius: 999px; background: rgba(212, 255, 63, 0.1); border: 1px solid rgba(212, 255, 63, 0.35); font-size: 13px; font-weight: 500; color: var(--beam); }
  .dpill i { width: 7px; height: 7px; border-radius: 50%; background: var(--beam); box-shadow: 0 0 0 3px rgba(212, 255, 63, 0.22); }
  h2 { font-size: clamp(32px, 3.4vw, 44px); line-height: 1.05; letter-spacing: -0.04em; font-weight: 600; color: #fff; margin-top: 16px; text-wrap: balance; }
  h2 .serif { color: var(--beam); }
  .lead { color: #C4C4CE; margin-top: 14px; font-size: 16.5px; line-height: 1.55; max-width: 460px; }
  .lead a { color: var(--beam); text-decoration-color: rgba(212, 255, 63, 0.5); }
  .lead a:hover { color: var(--beam-2); }
  .checks { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-direction: column; gap: 10px; }
  .checks li { display: flex; align-items: center; gap: 10px; font-size: 15px; color: #E6E6EC; }
  .ck { flex: none; width: 22px; height: 22px; border-radius: 50%; background: rgba(212, 255, 63, 0.14); border: 1px solid rgba(212, 255, 63, 0.4); display: inline-flex; align-items: center; justify-content: center; }
  .ck :global(.ic) { width: 12px; height: 12px; stroke: var(--beam); stroke-width: 3; }
  .pv-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 22px; color: var(--beam); font-weight: 500; font-size: 15px; text-underline-offset: 5px; }
  .pv-link:hover { color: var(--beam-2); }

  .right { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .zero { display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-radius: 22px; background: linear-gradient(180deg, #1A1A20, #141418); border: 1px solid #2c2c35; }
  .wf { width: 38px; height: 38px; border-radius: 12px; background: #22222a; display: inline-flex; align-items: center; justify-content: center; flex: none; }
  .wf .ic { width: 19px; height: 19px; stroke: #D8D8DE; }
  .zt b { display: block; font-size: 15.5px; color: #fff; }
  .zt small, .zn small { display: block; font-size: 12.5px; color: var(--app-mut); margin-top: 1px; }
  .zn { margin-left: auto; text-align: right; }
  .zn .mono { font-weight: 600; font-size: 30px; line-height: 1; letter-spacing: -0.03em; color: var(--beam); }
  .zn em { font-size: 15px; font-style: normal; color: #9aa83a; margin-left: 3px; }

  .cmpwrap { border-radius: 22px; background: #141418; border: 1px solid #2c2c35; padding: 8px 8px 0; }
  .cmpx { position: relative; display: grid; grid-template-columns: 1.3fr 1fr 1fr; }
  .row-c { display: contents; }
  .hl { position: absolute; top: 0; bottom: 0; left: 0; margin-left: calc(100% * 1.3 / 3.3); width: calc(100% / 3.3); border-radius: 16px; background: linear-gradient(180deg, rgba(212, 255, 63, 0.16), rgba(212, 255, 63, 0.06)); border: 1px solid rgba(212, 255, 63, 0.38); pointer-events: none; }
  .c { position: relative; display: flex; align-items: center; gap: 8px; min-height: 48px; padding: 8px 14px; border-top: 1px solid #2a2a33; font-size: 14.5px; }
  .h { min-height: 44px; border-top: 0; font-size: 13px; font-weight: 600; letter-spacing: 0.02em; }
  .lab { color: #E6E6EC; }
  .us { color: #fff; font-weight: 600; }
  .us :global(.ic) { width: 17px; height: 17px; stroke: var(--beam); stroke-width: 2.8; }
  .them { color: #A6A6B3; }
  .them :global(.ic) { width: 15px; height: 15px; stroke: #6f6f7c; stroke-width: 2.4; }
  .h.us { color: var(--beam); }
  .foot { border-top: 1px solid #2a2a33; padding: 10px 14px 12px; font-size: 12.5px; color: #8a8a97; }

  @media (max-width: 980px) {
    .pv { grid-template-columns: minmax(0, 1fr); padding: 32px 22px; gap: 28px; border-radius: 28px; }
  }
  @media (max-width: 640px) {
    .cmpx { grid-template-columns: 1.15fr 1fr 1fr; }
    .hl { margin-left: calc(100% * 1.15 / 3.15); width: calc(100% / 3.15); }
    .c { padding: 8px 10px; font-size: 13.5px; }
    .us :global(.ic), .them :global(.ic) { display: none; }
  }
</style>
