---
import DownloadButton from '../DownloadButton.astro';
import Icon from '../Icon.astro';
import release from '../../data/release.json';
---
<section class="wrap closing" data-section="closing">
  <div class="end">
    <div class="dots" aria-hidden="true"></div>
    <div class="copy">
      <span class="end-pill"><i></i>Free in early access</span>
      <h2>Stop scrolling for <span class="serif">that one screenshot.</span></h2>
      <p class="lead">Free, private and quiet. Download it, take a screenshot, and watch it name itself.</p>
      <div class="end-cta">
        <DownloadButton where="closing" class="btn btn-ink btn-lg" />
        <a class="end-link" href="#how" data-track="closing_how">See how it works<Icon name="arrow" class="ic ic-sm" /></a>
      </div>
      <ul class="end-trust">
        <li><Icon name="check" class="ic ic-sm" />No account</li>
        <li><Icon name="check" class="ic ic-sm" />Works offline</li>
        <li><Icon name="check" class="ic ic-sm" />macOS {release.minMacOS} or later</li>
      </ul>
    </div>
    <div class="scene" aria-hidden="true">
      <div class="searchbar"><Icon name="search" />invoice<span class="key key-d">⌥</span><span class="key key-d">Space</span></div>
      <div class="sheetc">
        <div class="shot"><i></i><i></i><i></i><b></b></div>
        <div class="cap"><span class="old">Screenshot 2026-11-12 at 9.41.07 PM.png</span></div>
      </div>
      <div class="toast toast2">
        <span class="g-a" style="width:44px;height:32px;border-radius:7px;flex:none"></span>
        <div style="min-width:0"><div style="font-size:12px;color:var(--app-mut)">Renamed on this Mac</div><div class="fname" style="font-size:13px">Stripe invoice March 2026.png</div></div>
        <span class="ok" style="margin-left:auto"><Icon name="check" /></span>
      </div>
    </div>
  </div>
</section>

<style>
  .closing { padding-top: 48px; padding-bottom: 112px; }
  .end {
    position: relative; overflow: hidden; display: grid; grid-template-columns: 1.05fr 1fr; gap: 40px; align-items: center;
    padding: 72px 72px 72px 80px; border-radius: 44px;
    background:
      radial-gradient(760px 420px at 100% 120%, #A5D80E 0%, rgba(165, 216, 14, 0) 62%),
      radial-gradient(620px 360px at -5% -25%, #F4FFA6 0%, rgba(244, 255, 166, 0) 62%),
      #D4FF3F;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.65) inset, 0 30px 70px rgba(150, 190, 0, 0.28);
  }
  .dots {
    position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(rgba(10, 10, 12, 0.13) 1.2px, transparent 1.4px); background-size: 22px 22px;
    -webkit-mask-image: linear-gradient(100deg, transparent 35%, #000 100%); mask-image: linear-gradient(100deg, transparent 35%, #000 100%);
  }
  .end > :not(.dots) { position: relative; }
  .end-pill { display: inline-flex; align-items: center; gap: 8px; height: 32px; padding: 0 14px 0 10px; border-radius: 999px; background: var(--ink); color: #E8FF8A; font-size: 13.5px; font-weight: 500; }
  .end-pill i { width: 8px; height: 8px; border-radius: 50%; background: var(--beam); box-shadow: 0 0 0 3px rgba(212, 255, 63, 0.3); }
  h2 { font-size: clamp(40px, 4.6vw, 64px); line-height: 1.02; letter-spacing: -0.045em; font-weight: 600; margin-top: 22px; text-wrap: balance; }
  .lead { color: #26300a; margin-top: 20px; max-width: 470px; }
  .end-cta { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; margin-top: 34px; }
  .end-cta :global(.btn-ink) { box-shadow: 0 12px 30px rgba(10, 10, 12, 0.25); }
  .end-link { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 15.5px; color: var(--ink); text-decoration: underline; text-decoration-color: rgba(10, 10, 12, 0.35); text-underline-offset: 5px; }
  .end-link:hover { color: var(--ink); text-decoration-color: var(--ink); }
  .end-trust { display: flex; gap: 10px 22px; flex-wrap: wrap; list-style: none; padding: 0; margin: 28px 0 0; font-size: 14.5px; color: #2d3810; }
  .end-trust li { display: flex; align-items: center; gap: 7px; }
  .end-trust :global(.ic) { stroke: var(--ink); stroke-width: 2.8; }

  .scene { position: relative; height: 410px; }
  .sheetc { position: absolute; left: 4%; top: 34px; width: 300px; border-radius: 22px; background: #fff; border: 1px solid rgba(10, 10, 12, 0.1); box-shadow: 0 28px 60px rgba(10, 10, 12, 0.2); transform: rotate(-5deg); overflow: hidden; }
  .shot { height: 168px; background: linear-gradient(135deg, #6C63FF, #B58CFF); position: relative; }
  .shot i { position: absolute; left: 16px; right: 16px; height: 10px; border-radius: 5px; background: rgba(255, 255, 255, 0.55); }
  .shot i:nth-child(1) { top: 22px; width: 46%; } .shot i:nth-child(2) { top: 46px; } .shot i:nth-child(3) { top: 68px; width: 70%; }
  .shot b { position: absolute; left: 16px; bottom: 18px; width: 86px; height: 34px; border-radius: 10px; background: var(--beam); border: 1px solid rgba(10, 10, 12, 0.25); }
  .cap { padding: 14px 16px; display: flex; flex-direction: column; gap: 6px; }
  .searchbar { position: absolute; z-index: 2; right: 0; top: -6px; display: flex; align-items: center; gap: 10px; height: 50px; padding: 0 14px 0 16px; border-radius: 16px; background: var(--app); color: var(--app-text); box-shadow: 0 22px 50px rgba(10, 10, 12, 0.35); font-size: 15px; transform: rotate(2deg); }
  .searchbar :global(.ic) { width: 17px; height: 17px; color: var(--app-mut); }
  .toast2 { position: absolute; z-index: 2; right: -6px; bottom: 30px; width: 390px; transform: rotate(-1.5deg); }
  .toast2 :global(.fname) { white-space: nowrap; word-break: normal; }

  @media (max-width: 980px) {
    .end { grid-template-columns: minmax(0, 1fr); padding: 44px 28px 36px; border-radius: 32px; gap: 28px; }
    .scene { height: 300px; max-width: 420px; }
    .sheetc { width: 240px; left: 0; } .shot { height: 124px; }
    .toast2 { width: 360px; right: 0; bottom: 8px; }
    .closing { padding-bottom: 72px; }
  }
  @media (max-width: 640px) { .end-cta :global(.btn) { width: 100%; } .toast2 { width: min(300px, 100%); right: 0; } .toast2 :global(.fname) { font-size: 12px; white-space: normal; word-break: break-all; } }
</style>
