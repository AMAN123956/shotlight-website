---
import AppIcon from '../AppIcon.astro';
import DownloadButton from '../DownloadButton.astro';
import Icon from '../Icon.astro';
import release from '../../data/release.json';

const date = new Date(release.date + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const steps = ['Drag to Applications', 'Open it, click Done', 'Click Open Anyway', 'Pick your folder'];
const chips = [`macOS ${release.minMacOS} or later`, release.arch, `${release.sizeMB} MB`, 'Free in early access'];
---
<section id="download" class="sec wrap" data-section="download">
  <div class="dlx">
    <div class="glow" aria-hidden="true"></div>
    <div class="top">
      <div class="ico"><AppIcon size={124} id="dlcard" /></div>
      <div class="main">
        <span class="dpill"><i></i>Version {release.version} · {date}</span>
        <h2>Shotlight for Mac</h2>
        <ul class="chips">
          {chips.map((c) => <li class="dchip"><Icon name="check" class="ic" />{c}</li>)}
        </ul>
      </div>
      <div class="cta">
        <DownloadButton where="home_card" label="Download .dmg" />
        <div class="brew"><span class="mono">brew install shotlight</span><span class="soon">Soon</span></div>
      </div>
    </div>

    {!release.signed && (
      <div class="steps">
        <div class="st-h"><b>First open takes 4 steps</b><span>This build is not signed by Apple yet, so macOS asks you to confirm it.</span></div>
        <ol class="st">
          {steps.map((s, i) => <li><i>{i + 1}</i>{s}</li>)}
        </ol>
        <a class="st-link" href="/download#first-open" data-track="home_first_open">See the steps<Icon name="arrow" class="ic ic-sm" /></a>
      </div>
    )}
    <div class="links">
      <a href="/verify">Verify the download</a>
      <a href="/changelog">What's new</a>
      <a href="https://github.com/AMAN123956/shotlight-releases/releases" data-track="home_all_versions">All versions on GitHub</a>
    </div>
  </div>
</section>

<style>
  .dlx {
    position: relative; overflow: hidden; border-radius: 44px; padding: 48px; color: var(--app-text);
    background: linear-gradient(160deg, #1B1B21 0%, #0F0F13 100%); border: 1px solid #2A2A33;
    box-shadow: 0 40px 90px rgba(10, 10, 12, 0.28);
  }
  .glow { position: absolute; width: 520px; height: 360px; left: -120px; top: -140px; border-radius: 50%; background: rgba(212, 255, 63, 0.2); filter: blur(100px); pointer-events: none; }
  .dlx > :not(.glow) { position: relative; }
  .top { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 40px; align-items: center; }
  .ico { justify-self: start; width: fit-content; border-radius: 30px; box-shadow: 0 0 0 10px rgba(212, 255, 63, 0.09), 0 28px 60px rgba(150, 190, 0, 0.35); line-height: 0; }
  .dpill { display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 14px 0 10px; border-radius: 999px; background: #202027; border: 1px solid #33333d; font-size: 13px; font-weight: 500; color: #D8D8DE; }
  .dpill i { width: 7px; height: 7px; border-radius: 50%; background: var(--beam); box-shadow: 0 0 0 3px rgba(212, 255, 63, 0.22); }
  h2 { font-size: clamp(34px, 3.8vw, 50px); line-height: 1.04; letter-spacing: -0.04em; font-weight: 600; margin-top: 16px; color: #fff; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 18px 0 0; }
  .dchip { display: inline-flex; align-items: center; gap: 7px; height: 32px; padding: 0 13px; border-radius: 999px; background: #1E1E25; border: 1px solid #30303a; font-size: 13.5px; color: #D8D8DE; }
  .dchip :global(.ic) { width: 14px; height: 14px; stroke: var(--beam); stroke-width: 2.4; }
  .cta { display: flex; flex-direction: column; gap: 14px; min-width: 270px; }
  .brew { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 48px; padding: 0 8px 0 16px; border-radius: 14px; background: #0A0A0D; border: 1px dashed #3a3a46; font-size: 13.5px; color: #A6A6B3; }
  .soon { height: 28px; padding: 0 10px; display: inline-flex; align-items: center; border-radius: 8px; background: #26262e; color: #D8D8DE; font: 600 11.5px var(--sans); letter-spacing: 0.06em; text-transform: uppercase; }

  .steps { display: grid; grid-template-columns: 240px minmax(0, 1fr) auto; gap: 28px; align-items: center; margin-top: 36px; padding: 24px 28px; border-radius: 26px; background: rgba(255, 255, 255, 0.04); border: 1px solid #2A2A33; }
  .st-h { display: flex; flex-direction: column; gap: 4px; }
  .st-h b { font-size: 17px; color: #fff; }
  .st-h span { font-size: 13.5px; color: var(--app-mut); line-height: 1.45; }
  .st { display: grid; grid-template-columns: repeat(4, 1fr); list-style: none; padding: 0; margin: 0; position: relative; }
  .st::before { content: ''; position: absolute; left: 14px; right: calc(25% - 14px); top: 14px; height: 2px; background: linear-gradient(90deg, var(--beam), #3a3a46 40%); border-radius: 1px; }
  .st li { position: relative; display: flex; flex-direction: column; gap: 10px; font-size: 13px; color: #C9C9D2; padding-right: 10px; }
  .st li i { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background: #16161b; border: 2px solid #3a3a46; font: 600 13px var(--sans); font-style: normal; color: #D8D8DE; }
  .st li:first-child i { background: var(--beam); border-color: var(--beam); color: var(--ink); }
  .st-link { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px; border-radius: 999px; border: 1px solid #3a3a46; color: #fff; text-decoration: none; font-weight: 500; font-size: 14.5px; white-space: nowrap; transition: background-color 120ms ease-out; }
  .st-link:hover { background: #202027; color: #fff; }
  .links { display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 24px; font-size: 14.5px; }
  .links a { color: var(--app-mut); text-decoration: none; }
  .links a:hover { color: var(--beam); }

  @media (max-width: 980px) {
    .dlx { padding: 28px 22px; border-radius: 32px; }
    .top { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .cta { min-width: 0; }
    .steps { grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 20px; }
    .st { grid-template-columns: repeat(2, 1fr); gap: 18px 10px; }
    .st::before { display: none; }
    .st-link { justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .st-link { transition: none; } }
</style>
