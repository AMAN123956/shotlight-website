---
// The pricing section exactly as designed on board 07 (#pricing), fed by src/data/pricing.json.
// NOT RENDERED while Shotlight is free. When pricing is decided: fill in pricing.json, render this in index.astro
// in place of <Pricing />, and update the hero note, FAQ and /download copy that say "free".
import pricing from '../../data/pricing.json';
---
<section id="pricing" class="band">
  <div class="wrap section stack" style="gap: 40px;">
    <div class="stack head">
      <span class="eyebrow">Pricing</span>
      <h2 class="h2">{pricing.title}</h2>
      <p class="sub">{pricing.subtitle}</p>
    </div>
    <div class="tiers">
      {pricing.tiers.map((t) => (
        <div class:list={['tier', t.style]}>
          <div class="stack" style="gap: 6px;">
            <span class="plan"><b>{t.name}</b>{t.badge && <span class="tag">{t.badge}</span>}</span>
            <span class="price">{t.price}{t.priceNote && <span class="price-note"> {t.priceNote}</span>}</span>
            <span class="desc">{t.description}</span>
          </div>
          {t.features.length > 0 && <ul class="feats">{t.features.map((f) => <li>✓ {f}</li>)}</ul>}
          <div style="flex: 1;"></div>
          <a href={t.cta.href} class:list={['btn', 'tier-btn', t.style === 'featured' ? 'btn-beam' : 'btn-ghost']}>{t.cta.label}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .head { gap: 12px; max-width: 640px; }
  .sub { font-size: 17px; color: var(--text-2); }
  .tiers { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 16px; }
  .tier { display: flex; flex-direction: column; gap: 20px; padding: 32px; border-radius: 20px; background: var(--card); border: 1px solid var(--line); }
  .tier.featured { border-color: var(--beam); box-shadow: 0 0 0 4px rgba(212, 255, 63, 0.08); }
  .tier.soon { background: var(--bg-alt); border-style: dashed; }
  .tier.soon .price { color: var(--text-2); }
  .plan { display: flex; justify-content: space-between; align-items: center; }
  .plan b { font-size: 20px; }
  .tag { font-size: 12px; font-weight: 600; padding: 3px 8px; border-radius: 6px; background: var(--beam); color: var(--bg); }
  .price { font-size: 40px; font-weight: 600; letter-spacing: -0.03em; }
  .price-note { font-size: 16px; font-weight: 500; color: var(--text-2); }
  .desc { font-size: 14px; color: var(--text-2); }
  .feats { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 15px; color: var(--text-soft); }
  .tier-btn { height: 48px; border-radius: 12px; }
</style>
