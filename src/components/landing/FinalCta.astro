---
<section class="wrap final">
  <div class="box">
    <div class="names">
      <span class="old mono">Screenshot 2026-11-12 at 9.41.07 PM.png</span>
      <span class="new mono">Shotlight – the last screenshot you’ll ever rename.png</span>
    </div>
    <h2>Take one screenshot. Watch it name itself.</h2>
    <a href="/download" class="btn btn-beam btn-lg">Download for Mac, free</a>
    <span class="fine">No account · No cloud · Works offline</span>
  </div>
</section>

<style>
  .final { padding-bottom: 96px; }
  .box {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; padding: 72px 24px;
    border-radius: 28px; background: var(--card); border: 1px solid var(--line);
  }
  .names { display: flex; flex-direction: column; gap: 4px; align-items: center; }
  .old { font-size: 15px; color: var(--text-4); text-decoration: line-through; overflow-wrap: anywhere; }
  .new { font-size: 17px; font-weight: 500; color: var(--beam); overflow-wrap: anywhere; }
  h2 { font-size: clamp(32px, 4.5vw, 56px); line-height: 1.05; letter-spacing: -0.04em; font-weight: 600; max-width: 760px; text-wrap: balance; }
  .fine { font-size: 13px; color: var(--text-3); }
  @media (max-width: 640px) { .final { padding-bottom: 72px; } .box { padding: 48px 20px; } }
</style>
