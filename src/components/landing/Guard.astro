---
---
<section id="guard" data-section="guard" class="wrap section split" data-guard>
  <div class="copy">
    <span class="eyebrow is-sensitive">Sensitive guard</span>
    <h2 class="h2">Screenshotted a secret? We noticed.</h2>
    <p class="lede">API keys, passwords, card numbers and one-time codes are spotted on your Mac, blurred in previews and kept out of search and Spotlight. Old one-time codes can go to the Trash after a week, with Restore.</p>
    <div class="kinds">
      <span>API keys</span><span>Passwords</span><span>Card numbers</span><span>OTP codes</span>
    </div>
  </div>
  <div class="demo">
    <div class="page shadow-xl" aria-label="Example: a payments dashboard's API keys page">
      <div class="page-bar">Developers · API keys</div>
      <div class="page-rows">
        <div class="kv"><span class="k">Publishable key</span><span class="mono">pk_live_51Hc8…Q2</span></div>
        <div class="kv"><span class="k">Secret key</span><span class="mono secret">sk_live_8f3K2pZ9vQ1mX4f2a</span></div>
        <div class="kv"><span class="k">Webhook secret</span><span class="mono secret">whsec_9Lk2Qw7Pz0aR</span></div>
      </div>
    </div>
    <div class="toggle-row panel">
      <span class="stack" style="gap: 2px;">
        <b data-title>Guard on · 2 secrets blurred</b>
        <span class="sub" data-sub>Hidden from search. Shown only when you ask.</span>
      </span>
      <button type="button" class="switch" role="switch" aria-checked="true" aria-label="Sensitive guard" data-toggle style="--switch-on: var(--sensitive);"><span></span></button>
    </div>
    <div class="expiring panel">
      <span class="stack" style="gap: 2px; min-width: 0;">
        <span class="exp-label">Guard › Expiring</span>
        <span class="mono exp-name">HDFC NetBanking – one-time code.png</span>
      </span>
      <span class="countdown">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2 2M10 2h4"></path></svg>
        Trash in 6 days
      </span>
    </div>
  </div>
</section>

<style>
  .copy { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .kinds { display: flex; gap: 8px; flex-wrap: wrap; }
  .kinds span { font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 8px; background: rgba(255, 122, 102, 0.12); color: var(--sensitive); }
  .demo { flex: 1.2 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .page { border-radius: 18px; overflow: hidden; background: #F7F7F9; color: #1A1A22; border: 1px solid var(--line); }
  .page-bar { padding: 12px 16px; background: #635BFF; color: #fff; font-size: 13px; font-weight: 600; }
  .page-rows { display: flex; flex-direction: column; padding: 8px 16px 16px; }
  .kv { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #E4E4EA; font-size: 13px; flex-wrap: wrap; }
  .kv:last-child { border-bottom: 0; }
  .k { color: #5A5A64; }
  .secret { transition: filter 220ms ease-out, color 220ms ease-out; filter: blur(5px); user-select: none; }
  [data-guard].is-off .secret { filter: none; color: #C2412C; user-select: text; }
  .toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 16px; border-radius: 14px; flex-wrap: wrap; }
  .toggle-row b { font-size: 14px; }
  .sub { font-size: 13px; color: var(--text-2); }
  .expiring { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-radius: 14px; flex-wrap: wrap; }
  .exp-label { font-size: 12px; color: var(--text-3); }
  .exp-name { font-size: 13px; font-weight: 500; overflow-wrap: anywhere; }
  .countdown {
    display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; font-size: 12px; font-weight: 600; padding: 4px 9px;
    border-radius: 7px; background: rgba(124, 196, 255, 0.12); color: var(--info); font-variant-numeric: tabular-nums;
  }
  @media (prefers-reduced-motion: reduce) { .secret { transition: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-guard]');
  if (root) {
    const btn = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const title = root.querySelector<HTMLElement>('[data-title]')!;
    const sub = root.querySelector<HTMLElement>('[data-sub]')!;
    btn.addEventListener('click', () => {
      const on = btn.getAttribute('aria-checked') !== 'true';
      btn.setAttribute('aria-checked', String(on));
      root.classList.toggle('is-off', !on);
      title.textContent = on ? 'Guard on · 2 secrets blurred' : 'Guard off · secrets exposed';
      sub.textContent = on ? 'Hidden from search. Shown only when you ask.' : 'This is what anyone glancing at your screen would see.';
    });
  }
</script>
