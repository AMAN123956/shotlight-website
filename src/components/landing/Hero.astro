---
import Thumb from '../Thumb.astro';
import MenuGlyph from '../MenuGlyph.astro';
import { seed } from './hero-data';
---
<section id="top" class="hero">
  <div class="hero-copy">
    <span class="badge"><span class="dot"></span>Mac app · 100% on-device</span>
    <h1>Your screenshots, finally findable.</h1>
    <div class="motif">
      <span class="old mono">Screenshot 2026-11-12 at 09.12.44.png</span>
      <span class="new mono"><span class="arrow">→</span> Figma – Pricing hero v3.png</span>
    </div>
    <p class="intro">Named the second you take it. Your old pile cleaned up in one click. Any screenshot found by the words inside it. Nothing ever leaves your Mac.</p>
    <div class="ctas">
      <a href="/download" class="btn btn-beam btn-lg">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 10l6 6 6-6M5 20h14"></path></svg>
        Download for Mac
      </a>
      <button type="button" class="btn btn-ghost btn-lg snap" data-snap>
        <span class="keys" aria-hidden="true"><kbd class="keycap">⇧</kbd><kbd class="keycap">⌘</kbd><kbd class="keycap">4</kbd></span>
        Take a screenshot
      </button>
    </div>
    <span class="note">Try it: press the button and watch the desktop. Free while in early access.</span>
  </div>

  <div class="hero-demo" data-hero>
    <div class="desktop" role="group" aria-label="Demo desktop. Screenshot files are renamed automatically.">
      <div class="menubar" aria-hidden="true">
        <span class="menus"><b>Finder</b><span>File</span><span>Edit</span><span>View</span></span>
        <span class="status">
          <span class="menu-icon" data-menu-icon>
            <MenuGlyph />
          </span>
          <span>Wi‑Fi off</span><span>Thu 9:41 PM</span>
        </span>
      </div>
      <div class="files" data-files>
        {seed.map((f) => (
          <div class="file" data-id={f.id}>
            <Thumb k={f.k} w={64} h={44} />
            <span class="label">{f.old}</span>
          </div>
        ))}
      </div>
      <div class="flash" data-flash hidden></div>
      <div class="pill-slot" data-pill-slot></div>
    </div>
    <div class="demo-bar">
      <span data-status aria-live="polite">Renaming {seed.length} screenshots on this Mac…</span>
      <span class="demo-actions">
        <button type="button" class="btn btn-ghost btn-sm" data-tidy>Tidy up all</button>
        <button type="button" class="btn btn-sm replay" data-replay>↺ Replay</button>
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    max-width: 1240px; margin: 0 auto; padding: 72px 24px 64px;
    display: flex; flex-wrap: wrap; gap: 48px; align-items: center;
  }
  .hero-copy { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .badge {
    display: inline-flex; align-items: center; gap: 8px; width: max-content; max-width: 100%; height: 30px; padding: 0 12px;
    border-radius: 999px; border: 1px solid var(--line); font-size: 13px; color: var(--text-2);
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--beam); }
  h1 { font-size: clamp(40px, 5.4vw, 70px); line-height: 1.02; font-weight: 600; letter-spacing: -0.045em; text-wrap: balance; }
  .motif {
    display: flex; flex-direction: column; gap: 6px; padding: 14px 16px; border-radius: 14px;
    background: var(--card); border: 1px solid var(--line); max-width: 480px;
  }
  .motif .old { font-size: 14px; color: var(--text-4); text-decoration: line-through; overflow-wrap: anywhere; }
  .motif .new { font-size: 16px; font-weight: 500; overflow-wrap: anywhere; }
  .arrow { color: var(--beam); }
  .intro { font-size: 18px; line-height: 1.55; color: var(--text-2); max-width: 500px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .snap { padding: 0 18px; font-size: 16px; }
  .keys { display: inline-flex; gap: 3px; }
  .note { font-size: 13px; color: var(--text-3); }

  .hero-demo { flex: 1.25 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .desktop {
    position: relative; height: 440px; border-radius: 18px; overflow: hidden; border: 1px solid var(--line);
    box-shadow: 0 50px 120px rgba(0, 0, 0, 0.6), 0 0 80px rgba(212, 255, 63, 0.05);
    background:
      radial-gradient(500px 300px at 15% 100%, #3A2E5C 0%, rgba(58, 46, 92, 0) 70%),
      radial-gradient(600px 360px at 100% 0%, #1F4A5A 0%, rgba(31, 74, 90, 0) 65%),
      #15161C;
  }
  .menubar {
    height: 26px; display: flex; align-items: center; justify-content: space-between; padding: 0 12px;
    background: rgba(12, 12, 16, 0.55); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    font-size: 12px; color: #E4E4EA; white-space: nowrap;
  }
  .menus, .status { display: flex; gap: 14px; align-items: center; }
  .status { gap: 12px; }
  .menu-icon {
    display: inline-flex; width: 26px; height: 18px; align-items: center; justify-content: center; border-radius: 4px;
    background: rgba(255, 255, 255, 0.14); transition: background-color 160ms ease-out;
  }
  .menu-icon.is-busy { background: rgba(212, 255, 63, 0.35); }
  .files {
    position: absolute; top: 42px; right: 16px; left: 16px;
    display: grid; grid-template-columns: repeat(auto-fill, 96px); justify-content: end; direction: rtl; gap: 14px 10px;
  }
  .files :global(.file) { display: flex; flex-direction: column; align-items: center; gap: 6px; width: 96px; direction: ltr; }
  .files :global(.label) {
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    max-width: 96px; padding: 1px 4px; border-radius: 4px; text-align: center; overflow-wrap: anywhere;
    font: 400 10px/1.25 var(--mono); color: rgba(255, 255, 255, 0.62); text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7);
  }
  .files :global(.label.is-done) { font-weight: 500; color: #fff; }
  .files :global(.label.is-hot) { background: var(--beam); color: var(--bg); text-shadow: none; }
  .flash { position: absolute; inset: 0; background: rgba(255, 255, 255, 0.35); pointer-events: none; }
  .pill-slot :global(.pill) {
    position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%);
    display: flex; align-items: center; gap: 10px; height: 42px; padding: 0 6px 0 8px; max-width: calc(100% - 24px);
    border-radius: 999px; background: rgba(24, 24, 30, 0.92); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5); white-space: nowrap;
  }
  .pill-slot :global(.pill-check) {
    flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: rgba(212, 255, 63, 0.18);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .pill-slot :global(.pill-name) { font: 500 13px var(--mono); overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .pill-slot :global(.pill-undo) {
    flex-shrink: 0; height: 30px; padding: 0 12px; border: 0; border-radius: 999px; background: var(--line);
    color: var(--text); font: 500 12px var(--keys); cursor: pointer; transition: background-color 120ms ease-out;
  }
  .pill-slot :global(.pill-undo:hover) { background: var(--line-strong); }
  .demo-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 13px; color: var(--text-3); min-height: 32px; }
  .demo-actions { display: flex; gap: 8px; }
  .replay { border: 1px solid var(--line); background: transparent; color: var(--text-2); }
  .replay:hover { color: var(--text); }

  @media (max-width: 640px) {
    .hero { padding: 48px 16px 40px; gap: 36px; }
    .desktop { height: 400px; }
    .files { left: 10px; right: 10px; gap: 12px 6px; }
    .menus span:not(:first-child) { display: none; }
  }
</style>

<script>
  import { seed, extras, type DemoFile } from './hero-data';
  import { thumbEl, reducedMotion } from '../../lib/thumb';

  const root = document.querySelector<HTMLElement>('[data-hero]');
  if (root) {
    const grid = root.querySelector<HTMLElement>('[data-files]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const flash = root.querySelector<HTMLElement>('[data-flash]')!;
    const pillSlot = root.querySelector<HTMLElement>('[data-pill-slot]')!;
    const menuIcon = root.querySelector<HTMLElement>('[data-menu-icon]')!;
    const reduced = reducedMotion();

    type F = DemoFile & { done: boolean; el?: HTMLElement };
    let files: F[] = seed.map((f) => ({ ...f, done: false }));
    let scanning: string | null = null;
    let newest: string | null = null;
    let pill: string | null = null;
    let timers: number[] = [];
    let extraIdx = 0;

    const later = (fn: () => void, ms: number) => { timers.push(window.setTimeout(fn, reduced ? 0 : ms)); };
    const clearTimers = () => { timers.forEach(clearTimeout); timers = []; };

    // Adopt the server-rendered elements.
    grid.querySelectorAll<HTMLElement>('.file').forEach((el) => {
      const f = files.find((x) => x.id === el.dataset.id);
      if (f) f.el = el;
    });

    function makeEl(f: F): HTMLElement {
      const el = document.createElement('div');
      el.className = 'file';
      el.dataset.id = f.id;
      const label = document.createElement('span');
      label.className = 'label';
      el.append(thumbEl(f.k, 64, 44), label);
      return el;
    }

    function paint() {
      // Keep DOM order in sync with `files` without recreating elements (so animations don't restart).
      files.forEach((f, i) => {
        if (!f.el) { f.el = makeEl(f); if (!reduced) f.el.classList.add('sl-pop'); }
        if (grid.children[i] !== f.el) grid.insertBefore(f.el, grid.children[i] ?? null);
        const label = f.el.querySelector<HTMLElement>('.label')!;
        const text = f.done ? f.nu : f.old;
        if (label.textContent !== text) label.textContent = text;
        label.classList.toggle('is-done', f.done);
        label.classList.toggle('is-hot', f.done && newest === f.id);
        const scan = scanning === f.id && !reduced;
        if (scan && !label.classList.contains('sl-scan')) label.classList.add('sl-scan');
        if (!scan) label.classList.remove('sl-scan');
      });
      while (grid.children.length > files.length) grid.lastElementChild!.remove();

      menuIcon.classList.toggle('is-busy', scanning !== null);
      const left = files.filter((f) => !f.done).length;
      const text = left ? `Renaming ${left} screenshot${left === 1 ? '' : 's'} on this Mac…` : 'All named. Take another one ↑';
      if (status.textContent !== text) status.textContent = text;
      paintPill();
    }

    let pillShown: string | null = null;
    function paintPill() {
      const f = files.find((x) => x.id === pill && x.done);
      const id = f ? f.id : null;
      if (id === pillShown) return;
      pillShown = id;
      pillSlot.replaceChildren();
      if (!f) return;
      const el = document.createElement('div');
      el.className = reduced ? 'pill' : 'pill sl-pill';
      el.setAttribute('role', 'status');
      el.innerHTML =
        '<span class="pill-check"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#D4FF3F" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4L19 6"></path></svg></span>';
      const name = document.createElement('span');
      name.className = 'pill-name';
      name.textContent = f.nu;
      const undo = document.createElement('button');
      undo.type = 'button';
      undo.className = 'pill-undo';
      undo.textContent = 'Undo';
      undo.addEventListener('click', () => {
        f.done = false; pill = null; newest = null; paint();
        root!.querySelector<HTMLButtonElement>('[data-tidy]')?.focus();
      });
      el.append(name, undo);
      pillSlot.append(el);
    }

    function renameOne(f: F, delay: number) {
      later(() => { scanning = f.id; paint(); }, delay);
      later(() => { f.done = true; scanning = null; pill = f.id; newest = f.id; paint(); }, delay + 520);
    }

    function runAll(start: number) {
      const todo = files.filter((f) => !f.done);
      todo.forEach((f, i) => renameOne(f, start + i * 850));
      later(() => { newest = null; paint(); }, start + todo.length * 850 + 2200);
    }

    root.querySelector('[data-tidy]')!.addEventListener('click', () => runAll(0));
    root.querySelector('[data-replay]')!.addEventListener('click', () => {
      clearTimers();
      files.forEach((f) => f.el?.remove());
      files = seed.map((f) => ({ ...f, done: false }));
      pill = null; newest = null; scanning = null;
      paint();
      runAll(400);
    });
    document.querySelector('[data-snap]')?.addEventListener('click', () => {
      const ex = extras[extraIdx % extras.length];
      extraIdx += 1;
      const nf: F = { ...ex, id: `n${extraIdx}`, done: false };
      const dropped = [nf, ...files].slice(10);
      dropped.forEach((f) => f.el?.remove());
      files = [nf, ...files].slice(0, 10);
      if (!reduced) {
        flash.hidden = false;
        window.setTimeout(() => { flash.hidden = true; }, 140);
      }
      paint();
      renameOne(nf, 650);
    });

    // Start when the desktop first scrolls into view (it's above the fold on most screens).
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); runAll(700); }
    }, { threshold: 0.3 });
    io.observe(root);
  }
</script>
