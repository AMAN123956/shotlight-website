---
import Thumb from '../Thumb.astro';
import Seg from '../Seg.astro';
import { examples, exampleName, initialNaming } from './naming';
const tokens: ['app' | 'date', string][] = [['app', 'App name'], ['date', 'Date']];
---
<section id="naming" class="band" data-section="naming" data-naming>
  <div class="wrap section stack" style="gap: 40px;">
    <div class="stack head">
      <span class="eyebrow">Your names, your way</span>
      <h2 class="h2">Play with it. The names change as you click.</h2>
    </div>
    <div class="body">
      <div class="controls panel">
        <div class="group">
          <span class="group-label" id="nm-detail">Detail</span>
          <Seg label="Detail" name="detail" value="std" options={[['short', 'Short'], ['std', 'Standard'], ['det', 'Detailed']]} />
        </div>
        <div class="group">
          <span class="group-label">Include</span>
          <div class="tokens">
            {tokens.map(([id, label]) => {
              const on = initialNaming[id];
              return <button type="button" class="token mono" data-token={id} data-label={label} aria-pressed={String(on)}>{(on ? '✓ ' : '+ ') + label}</button>;
            })}
          </div>
        </div>
        <div class="group">
          <span class="group-label">Letter case</span>
          <Seg label="Letter case" name="case" value="sentence" options={[['sentence', 'Sentence'], ['lower', 'lower'], ['kebab', 'kebab-case']]} />
        </div>
        <span class="more">In the app you also get separators, date formats, and names that learn from your edits.</span>
      </div>
      <div class="cards" aria-live="polite">
        {examples.map((e, i) => (
          <div class="card panel">
            <Thumb k={e.k} w="full" h={120} />
            <span class="card-name mono" data-example={i}>{exampleName(e, initialNaming)}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="learn panel" data-learn>
      <div class="learn-copy">
        <span class="eyebrow">New · learns from your edits</span>
        <b class="learn-title">Fix a name three times, and it asks once.</b>
        <span class="learn-body">Only the names you type are kept, never the text in the screenshot. Settings › Naming lists what it learned, and you can remove any of it.</span>
        <span class="learn-actions">
          <button type="button" class="btn btn-ghost btn-sm" data-learn-go>Make three edits</button>
          <button type="button" class="btn btn-ghost btn-sm" data-learn-reset hidden>↺ Reset</button>
        </span>
      </div>
      <ol class="edits" aria-live="polite">
        <li class="edit" data-edit><span class="old mono">Safari – Linear issue 412, login loop.png</span><span class="new mono">Linear issue 412, login loop.png</span></li>
        <li class="edit" data-edit><span class="old mono">Chrome – Vercel deploy failed.png</span><span class="new mono">Vercel deploy failed.png</span></li>
        <li class="edit" data-edit><span class="old mono">Slack – Design review notes.png</span><span class="new mono">Design review notes.png</span></li>
      </ol>
      <div class="ask" data-ask hidden>
        <span class="ask-q">You usually drop the app name. Always?</span>
        <span class="learn-actions">
          <button type="button" class="btn btn-beam btn-sm" data-always>Always</button>
          <button type="button" class="btn btn-ghost btn-sm" data-not-now>Not now</button>
        </span>
      </div>
      <span class="learned" data-learned hidden></span>
    </div>
  </div>
</section>

<style>
  .head { gap: 14px; max-width: 680px; }
  .body { display: flex; flex-wrap: wrap; gap: 24px; align-items: stretch; }
  .controls { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 18px; padding: 24px; }
  .group { display: flex; flex-direction: column; gap: 8px; }
  .group-label { font-size: 13px; color: var(--text-2); }
  .tokens { display: flex; gap: 6px; flex-wrap: wrap; }
  .token {
    height: 32px; padding: 0 12px; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 500;
    background: transparent; color: var(--text-2); border: 1px dashed var(--line-strong);
    transition: background-color 120ms ease-out, color 120ms ease-out, border-color 120ms ease-out;
  }
  .token:hover { color: var(--text); }
  .token[aria-pressed='true'] { background: rgba(212, 255, 63, 0.12); color: var(--beam); border: 1px solid rgba(212, 255, 63, 0.4); }
  .more { font-size: 13px; line-height: 1.5; color: var(--text-3); }
  .cards { flex: 1.4 1 480px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; align-content: start; }
  .card { display: flex; flex-direction: column; overflow: hidden; border-radius: 16px; }
  .card-name { padding: 14px; font-size: 13px; line-height: 1.45; font-weight: 500; overflow-wrap: anywhere; }
  .learn { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 16px 32px; padding: 24px; align-items: start; }
  .learn-copy { display: flex; flex-direction: column; gap: 10px; grid-row: span 3; }
  .learn-title { font-size: 20px; letter-spacing: -0.015em; }
  .learn-body { font-size: 15px; line-height: 1.55; color: var(--text-2); }
  .learn-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .learn-actions .btn[hidden] { display: none; }
  .edits { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .edit {
    display: flex; flex-direction: column; gap: 3px; padding: 10px 12px; border-radius: 12px; background: var(--surface-2);
    border: 1px solid var(--line); opacity: 0.4; transition: opacity 200ms ease-out;
  }
  .edit.done { opacity: 1; }
  .old { font-size: 12px; color: var(--text-4); overflow-wrap: anywhere; }
  .edit.done .old { text-decoration: line-through; }
  .new { font-size: 13px; font-weight: 500; overflow-wrap: anywhere; }
  .ask { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 10px 10px 16px; border-radius: 999px; background: #24242C; border: 1px solid #33333C; }
  .ask[hidden], .learned[hidden] { display: none; }
  .ask-q { font-size: 14px; font-weight: 500; }
  .learned { font-size: 14px; color: var(--beam); }
  @media (max-width: 760px) { .learn { grid-template-columns: minmax(0, 1fr); } .learn-copy { grid-row: auto; } .ask { border-radius: 16px; } }
  @media (prefers-reduced-motion: reduce) { .edit { transition: none; } }
</style>

<script>
  import { radioGroup } from '../../lib/radiogroup';
  import { examples, exampleName, initialNaming, type NamingState, type Detail, type Case } from './naming';

  const root = document.querySelector<HTMLElement>('[data-naming]');
  if (root) {
    const s: NamingState = { ...initialNaming };
    const names = [...root.querySelectorAll<HTMLElement>('[data-example]')];
    const paint = () => names.forEach((el) => { el.textContent = exampleName(examples[Number(el.dataset.example)], s); });
    radioGroup(root.querySelector('[data-seg="detail"]')!, (v) => { s.detail = v as Detail; paint(); });
    radioGroup(root.querySelector('[data-seg="case"]')!, (v) => { s.kase = v as Case; paint(); });
    root.querySelectorAll<HTMLButtonElement>('[data-token]').forEach((b) => {
      b.addEventListener('click', () => {
        const id = b.dataset.token as 'app' | 'date';
        s[id] = !s[id];
        b.setAttribute('aria-pressed', String(s[id]));
        b.textContent = (s[id] ? '✓ ' : '+ ') + b.dataset.label;
        paint();
      });
    });

    // Learning from edits: three renames that drop the app name, then the pill's one-time question.
    // "Always" switches the playground's own "App name" token off, so the names above change too.
    const learn = root.querySelector<HTMLElement>('[data-learn]')!;
    const edits = [...learn.querySelectorAll<HTMLElement>('[data-edit]')];
    const ask = learn.querySelector<HTMLElement>('[data-ask]')!;
    const learned = learn.querySelector<HTMLElement>('[data-learned]')!;
    const go = learn.querySelector<HTMLButtonElement>('[data-learn-go]')!;
    const reset = learn.querySelector<HTMLButtonElement>('[data-learn-reset]')!;
    const appToken = root.querySelector<HTMLButtonElement>('[data-token="app"]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timers: number[] = [];
    let switchedApp = false;
    const pop = (el: HTMLElement) => { if (reduced) return; el.classList.remove('sl-pop'); void el.offsetWidth; el.classList.add('sl-pop'); };
    const clear = () => { timers.forEach(clearTimeout); timers = []; };

    go.addEventListener('click', () => {
      clear();
      go.disabled = true;
      edits.forEach((e, i) => timers.push(window.setTimeout(() => { e.classList.add('done'); pop(e); }, reduced ? 0 : 350 * (i + 1))));
      timers.push(window.setTimeout(() => { ask.hidden = false; pop(ask); reset.hidden = false; learn.querySelector<HTMLButtonElement>('[data-always]')!.focus(); }, reduced ? 0 : 1400));
    });
    learn.querySelector('[data-always]')!.addEventListener('click', () => {
      ask.hidden = true;
      if (s.app) { appToken.click(); switchedApp = true; }
      learned.textContent = '✓ App name is now off. The names above changed. Undo is in Settings › Naming.';
      learned.hidden = false;
      pop(learned);
      reset.focus();
    });
    learn.querySelector('[data-not-now]')!.addEventListener('click', () => {
      ask.hidden = true;
      learned.textContent = 'It won’t ask about this habit again.';
      learned.hidden = false;
      reset.focus();
    });
    reset.addEventListener('click', () => {
      clear();
      edits.forEach((e) => e.classList.remove('done'));
      ask.hidden = true;
      learned.hidden = true;
      if (switchedApp && !s.app) appToken.click();
      switchedApp = false;
      go.disabled = false;
      reset.hidden = true;
      go.focus();
    });
  }
</script>
