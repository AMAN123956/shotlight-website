---
import Thumb from '../Thumb.astro';
import Seg from '../Seg.astro';
import type { Kind } from '../../lib/thumb';

const rows: [string, string, Kind, string][] = [
  ['Screenshot 2025-12-15 at 06.59.24.png', 'Gmail – Flight PNR 6E-2041 to Goa.png', 'chat', '15 Dec 2025'],
  ['Screenshot 2026-01-04 at 11.42.17.png', 'GitHub – PR 381 review comments.png', 'code', '4 Jan'],
  ['Screenshot 2026-02-02 at 17.33.40.png', 'Swiggy order – ₹389, Meghana Foods.png', 'receipt', '2 Feb'],
  ['Screenshot 2026-02-14 at 20.05.12.png', 'Figma – Onboarding flow v2.png', 'design', '14 Feb'],
  ['Screenshot 2026-03-01 at 14.27.09.png', 'Excel – Q1 expenses summary.png', 'map', '1 Mar'],
  ['Screenshot 2026-03-22 at 08.48.31.png', 'Instagram – Café moodboard.png', 'photo', '22 Mar'],
  ['Screen Recording 2026-04-10 at 16.20.11.mov', 'Recording – Safari checkout bug, 42s.mov', 'video', '10 Apr'],
  ['Screenshot 2026-05-03 at 10.11.45.png', 'Notion – Launch plan, week 1.png', 'design', '3 May'],
];
---
<section class="wrap section split" aria-labelledby="tidy-title" data-tidy-demo>
  <div class="window panel shadow-xl">
    <div class="titlebar">
      <span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
      <b>Desktop · 214 screenshots</b>
      <Seg label="Before or after Tidy Up" name="ba" value="before" options={[['before', 'Before'], ['after', 'After Tidy Up']]} />
    </div>
    <div class="rows" aria-live="polite">
      {rows.map(([o, n, k, date]) => (
        <div class="row sl-row">
          <Thumb k={k} w={44} h={30} />
          <span class="name mono" data-old={o} data-new={n}>{o}</span>
          <span class="date">{date}</span>
        </div>
      ))}
      <div class="more">+ 206 more</div>
    </div>
  </div>
  <div class="copy">
    <span class="eyebrow">Tidy Up</span>
    <h2 class="h2" id="tidy-title">Your old pile, fixed in one click.</h2>
    <p class="lede">Point it at any folder. Preview every new name, uncheck what you don’t like, press Rename. Dates stay untouched, and one Undo puts everything back.</p>
    <div class="stat">
      <b data-stat>214</b>
      <span data-stat-label>files called “Screenshot…”</span>
    </div>
  </div>
</section>

<style>
  .window { flex: 1.3 1 520px; min-width: 0; display: flex; flex-direction: column; overflow: hidden; }
  .titlebar {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px; flex-wrap: wrap;
    border-bottom: 1px solid #24242C; background: #16161B;
  }
  .titlebar b { font-size: 13px; }
  .lights { display: flex; gap: 7px; }
  .lights span { width: 11px; height: 11px; border-radius: 50%; background: #FF5F57; }
  .lights span:nth-child(2) { background: #FEBC2E; }
  .lights span:nth-child(3) { background: #28C840; }
  .rows { display: flex; flex-direction: column; }
  .row { display: flex; align-items: center; gap: 12px; padding: 9px 14px; border-bottom: 1px solid var(--line-soft); }
  .name {
    flex: 1; min-width: 0; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-3);
    transition: color 220ms ease-out;
  }
  .is-after .name { color: var(--text); font-weight: 500; }
  .date { font-size: 12px; color: var(--text-4); white-space: nowrap; }
  .more { padding: 10px 14px; font-size: 12px; color: var(--text-4); }
  .copy { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .stat { display: flex; flex-direction: column; }
  .stat b { font-size: 32px; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .stat span { font-size: 13px; color: var(--text-3); }
  @media (max-width: 640px) { .copy { order: -1; } }
</style>

<script>
  import { radioGroup } from '../../lib/radiogroup';
  import { reducedMotion } from '../../lib/thumb';

  const root = document.querySelector<HTMLElement>('[data-tidy-demo]');
  if (root) {
    const names = [...root.querySelectorAll<HTMLElement>('.name')];
    const rows = root.querySelector<HTMLElement>('.rows')!;
    const stat = root.querySelector<HTMLElement>('[data-stat]')!;
    const statLabel = root.querySelector<HTMLElement>('[data-stat-label]')!;
    const reduced = reducedMotion();
    let timers: number[] = [];
    radioGroup(root.querySelector('[data-seg="ba"]')!, (v) => {
      const after = v === 'after';
      timers.forEach(clearTimeout); timers = [];
      rows.classList.toggle('is-after', after);
      stat.textContent = after ? '0' : '214';
      statLabel.textContent = after ? 'files still called “Screenshot…”' : 'files called “Screenshot…”';
      // Rename row by row, top to bottom, with the beam sweep (instant under Reduce Motion).
      names.forEach((n, i) => {
        const apply = () => {
          n.textContent = after ? n.dataset.new! : n.dataset.old!;
          n.classList.remove('sl-scan');
          if (after && !reduced) { void n.offsetWidth; n.classList.add('sl-scan'); }
        };
        if (reduced) apply(); else timers.push(window.setTimeout(apply, i * 60));
      });
    });
  }
</script>
