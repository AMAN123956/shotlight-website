---
import Thumb from '../Thumb.astro';
import { index, chips, folders } from './search-data';
const initial = index.slice(0, 4);
---
<section id="search" class="band" data-section="search">
  <div class="wrap section split">
    <div class="copy">
      <span class="eyebrow">Find anything</span>
      <h2 class="h2">Remember one word. That’s enough.</h2>
      <p class="lede">Press ⌥ Space from anywhere. Shotlight searches every word inside every screenshot, what was said in recordings, the app it came from and its name. It’s all indexed on your Mac.</p>
      <span class="try">Go on, try it →</span>
    </div>
    <div class="window shadow-xl" data-search>
      <div class="top">
        <label class="field">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#A6A6B3" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
          <span class="sr-only">Search the demo screenshots</span>
          <input type="search" data-q placeholder="Type receipt, goa, error, OTP…" autocomplete="off" spellcheck="false" />
          <span class="count" data-count aria-live="polite">Recent</span>
        </label>
        <div class="chips">
          <span class="chips-label">Try</span>
          {chips.map((c) => <button type="button" class="chip" data-chip={c} aria-pressed="false">{c}</button>)}
        </div>
        <div class="chips">
          <span class="chips-label">Folders</span>
          {folders.map((f) => <button type="button" class="chip folder" data-folder={f} aria-pressed="false">{f}</button>)}
        </div>
      </div>
      <div class="divider"></div>
      <div class="results" data-results>
        {initial.map((x) => (
          <div class="row">
            <Thumb k={x.k} w={64} h={44} />
            <span class="row-text">
              <span class="row-name mono">{x.n}</span>
              <span class="row-sub">{x.t}</span>
            </span>
            {x.said && <span class="said mono">{x.said}</span>}
            {x.sens && <span class="sens">{x.sens}</span>}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .copy { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .try { font-size: 14px; color: var(--text-soft); }
  .window {
    flex: 1.3 1 520px; min-width: 0; display: flex; flex-direction: column; border-radius: 18px; overflow: hidden;
    background: rgba(26, 26, 32, 0.95); border: 1px solid var(--line);
  }
  .top { display: flex; flex-direction: column; gap: 10px; padding: 14px; }
  .field {
    display: flex; align-items: center; gap: 10px; height: 48px; padding: 0 14px; border-radius: 12px;
    background: rgba(255, 255, 255, 0.05); border: 1px solid var(--beam); box-shadow: 0 0 0 4px rgba(212, 255, 63, 0.12);
  }
  .field:focus-within { box-shadow: 0 0 0 4px rgba(212, 255, 63, 0.24); }
  input { flex: 1; min-width: 0; border: 0; outline: none; background: transparent; color: var(--text); font: 400 17px var(--sans); }
  input::placeholder { color: var(--text-4); }
  input::-webkit-search-cancel-button { filter: invert(0.7); }
  .count { font-size: 12px; color: var(--text-2); white-space: nowrap; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .chips-label { font-size: 12px; color: var(--text-3); margin-right: 4px; }
  .chip {
    height: 28px; padding: 0 12px; border-radius: 999px; cursor: pointer; font: 500 12px var(--sans);
    background: transparent; color: var(--text-soft); border: 1px solid var(--line);
    transition: background-color 120ms ease-out, border-color 120ms ease-out, color 120ms ease-out;
  }
  .chip:hover { border-color: var(--line-strong); color: var(--text); }
  .chip[aria-pressed='true'] { background: var(--beam); color: var(--bg); border-color: var(--beam); }
  .chip.folder { border-style: dashed; }
  .chip.folder[aria-pressed='true'] { border-style: solid; }
  .divider { height: 1px; background: #24242C; }
  .results { display: flex; flex-direction: column; padding: 6px; min-height: 300px; }
  .results :global(.row) { display: flex; align-items: center; gap: 14px; padding: 10px; border-radius: 12px; }
  .results :global(.row-text) { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }
  .results :global(.row-name) { font-size: 14px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .results :global(.row-sub) { font-size: 13px; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .results :global(mark) { background: rgba(212, 255, 63, 0.24); color: var(--beam-hover); border-radius: 3px; padding: 0 2px; }
  .results :global(.sens) {
    flex-shrink: 0; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 6px;
    background: rgba(255, 122, 102, 0.14); color: var(--sensitive);
  }
  .results :global(.said) { flex-shrink: 0; font-size: 12px; font-weight: 600; color: var(--info); }
  .results :global(.empty) { padding: 48px 16px; text-align: center; font-size: 14px; color: var(--text-2); }
  @media (max-width: 640px) {
    .results :global(.row) { gap: 10px; padding: 8px 6px; }
  }
</style>

<script>
  import { index } from './search-data';
  import { thumbEl, reducedMotion } from '../../lib/thumb';

  const root = document.querySelector<HTMLElement>('[data-search]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-q]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const list = root.querySelector<HTMLElement>('[data-results]')!;
    const chipEls = [...root.querySelectorAll<HTMLButtonElement>('[data-chip]')];
    const folderEls = [...root.querySelectorAll<HTMLButtonElement>('[data-folder]')];
    let folder: string | null = null;
    const reduced = reducedMotion();
    let lastKey = index.slice(0, 4).map((x) => x.n).join('|');

    function row(x: (typeof index)[number], q: string): HTMLElement {
      const el = document.createElement('div');
      el.className = 'row';
      const text = document.createElement('span');
      text.className = 'row-text';
      const name = document.createElement('span');
      name.className = 'row-name mono';
      name.textContent = x.n;
      const sub = document.createElement('span');
      sub.className = 'row-sub';
      const i = q ? x.t.toLowerCase().indexOf(q) : -1;
      if (i >= 0) {
        const mark = document.createElement('mark');
        mark.textContent = x.t.slice(i, i + q.length);
        sub.append(x.t.slice(0, i), mark, x.t.slice(i + q.length));
      } else {
        sub.textContent = x.t;
      }
      text.append(name, sub);
      el.append(thumbEl(x.k, 64, 44), text);
      if (x.said) {
        const t = document.createElement('span');
        t.className = 'said mono';
        t.textContent = x.said;
        t.title = 'When it was said';
        el.append(t);
      }
      if (x.sens) {
        const b = document.createElement('span');
        b.className = 'sens';
        b.textContent = x.sens;
        el.append(b);
      }
      return el;
    }

    function update() {
      const raw = input.value;
      const q = raw.trim().toLowerCase();
      const pool = folder ? index.filter((x) => x.folder === folder) : index;
      const matched = q ? pool.filter((x) => (x.n + ' ' + x.t).toLowerCase().includes(q)) : folder ? pool : index.slice(0, 4);
      const key = matched.map((x) => x.n).join('|');
      const changed = key !== lastKey;
      lastKey = key;
      list.replaceChildren(
        ...(matched.length
          ? matched.map((x) => {
              const el = row(x, q);
              if (changed && !reduced) el.classList.add('sl-pop');
              return el;
            })
          : [Object.assign(document.createElement('div'), {
              className: 'empty',
              textContent: `No match for “${raw.trim()}”. Try a word that’s inside a screenshot.`,
            })]),
      );
      count.textContent = q || folder ? `${matched.length} found` : 'Recent';
      folderEls.forEach((f) => f.setAttribute('aria-pressed', String(f.dataset.folder === folder)));
      chipEls.forEach((c) => c.setAttribute('aria-pressed', String(q === c.dataset.chip!.toLowerCase())));
    }

    input.addEventListener('input', update);
    chipEls.forEach((c) => c.addEventListener('click', () => { input.value = c.dataset.chip!; update(); }));
    folderEls.forEach((f) => f.addEventListener('click', () => { folder = folder === f.dataset.folder ? null : f.dataset.folder!; update(); }));
  }
</script>
