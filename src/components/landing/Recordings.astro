---
import { lines, total, fmt } from './recording-data';
const frames = [
  { label: 'Cart', bg: '#F7F7F9', bar: '#1E1E24', blk: '#E9E9EF', l: ['#1E1E24', '#B9B9C4', '#B9B9C4'] },
  { label: 'Checkout', bg: '#F7F7F9', bar: '#1E1E24', blk: '#E9E9EF', l: ['#1E1E24', '#635BFF', '#B9B9C4'] },
  { label: 'Error', bg: '#F7F7F9', bar: '#1E1E24', blk: '#FFF1EE', l: ['#C2412C', '#E0A99D', '#E0A99D'] },
  { label: 'Console', bg: '#1B1B21', bar: '#7CC4FF', blk: '#232329', l: ['#D4FF3F', '#7CC4FF', '#55555F'] },
];
---
<section id="recordings" data-section="recordings" class="wrap section stack" style="gap: 40px;" aria-labelledby="rec-title" data-recs>
  <div class="stack head">
    <span class="eyebrow">Screen recordings</span>
    <h2 class="h2" id="rec-title">Find the moment someone said it.</h2>
    <p class="lede">Shotlight reads four frames of every recording and transcribes the speech on your Mac, with a model macOS already has. It never downloads one. Search by what was said and the clip starts right there.</p>
  </div>
  <div class="grid">
    <div class="card panel shadow-xl">
      <div class="scrub" data-scrub tabindex="0" role="slider" aria-label="Look through the recording" aria-valuemin="0" aria-valuemax={total} aria-valuenow="0" aria-valuetext="0:00">
        {frames.map((f, i) => (
          <div class:list={['frame', { on: i === 0 }]} style={`background: ${f.bg};`} aria-hidden="true">
            <span class="bar" style={`background: ${f.bar};`}></span>
            <span class="blk" style={`background: ${f.blk};`}>
              <span style={`background: ${f.l[0]}; width: 55%;`}></span>
              <span class:list={[{ cta: i === 1 }]} style={`background: ${f.l[1]}; width: ${i === 1 ? 35 : 80}%;`}></span>
              <span style={`background: ${f.l[2]}; width: 65%;`}></span>
            </span>
            <span class="label mono">{f.label}</span>
          </div>
        ))}
        <span class="dur mono" data-dur>{fmt(total)}</span>
        <span class="prog" aria-hidden="true"><span data-prog></span></span>
      </div>
      <span class="name mono">Recording – Safari checkout bug, 42s.mov</span>
      <span class="hint" data-hint aria-live="polite">Move the pointer across it to look through.</span>
    </div>
    <div class="said panel shadow-xl">
      <label class="field">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#A6A6B3" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <span class="sr-only">Search what was said in the recording</span>
        <input type="search" data-q placeholder="Type checkout, code, refund…" autocomplete="off" spellcheck="false" />
        <span class="count" data-count aria-live="polite">Speech · {lines.length} lines</span>
      </label>
      <div class="segs" data-segs>
        {lines.map((l) => (
          <button type="button" class="seg" data-t={l.t}>
            <span class="ts mono">{fmt(l.t)}</span>
            <span>{l.s}{l.code && <> <span class="blank" aria-label="code hidden">••••••</span></>}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .head { gap: 14px; max-width: 700px; }
  .grid { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
  .card { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 10px; padding: 12px; }
  .scrub { position: relative; aspect-ratio: 16 / 10; max-width: 100%; border-radius: 12px; overflow: hidden; cursor: ew-resize; background: #26262B; touch-action: pan-y; }
  .frame { position: absolute; inset: 0; padding: 7%; display: flex; flex-direction: column; gap: 7%; opacity: 0; transition: opacity 120ms linear; }
  .frame.on { opacity: 1; }
  .bar { display: block; height: 9%; width: 40%; border-radius: 4px; }
  .blk { flex: 1; border-radius: 6px; display: flex; flex-direction: column; justify-content: center; gap: 10%; padding: 6%; }
  .blk span { display: block; height: 8px; border-radius: 3px; }
  .blk span.cta { height: 18px; border-radius: 5px; }
  .label { position: absolute; left: 7%; bottom: 8%; font-size: 11px; font-weight: 600; padding: 3px 7px; border-radius: 6px; background: rgba(0, 0, 0, 0.55); color: #fff; }
  .dur { position: absolute; right: 8px; bottom: 9px; font-size: 11px; font-weight: 600; padding: 3px 7px; border-radius: 6px; background: rgba(0, 0, 0, 0.6); color: #fff; font-variant-numeric: tabular-nums; }
  .prog { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: rgba(255, 255, 255, 0.15); }
  .prog span { display: block; height: 100%; width: 0; background: var(--beam); }
  .name { font-size: 13px; font-weight: 500; overflow-wrap: anywhere; }
  .hint { font-size: 12px; color: var(--text-3); }
  .said { flex: 1.2 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 10px; padding: 14px; }
  .field {
    display: flex; align-items: center; gap: 10px; height: 48px; padding: 0 14px; border-radius: 12px;
    background: rgba(255, 255, 255, 0.05); border: 1px solid var(--beam); box-shadow: 0 0 0 4px rgba(212, 255, 63, 0.12);
  }
  .field:focus-within { box-shadow: 0 0 0 4px rgba(212, 255, 63, 0.24); }
  input { flex: 1; min-width: 0; border: 0; outline: none; background: transparent; color: var(--text); font: 400 17px var(--sans); }
  input::placeholder { color: var(--text-4); }
  input::-webkit-search-cancel-button { filter: invert(0.7); }
  .count { font-size: 12px; color: var(--text-2); white-space: nowrap; }
  .segs { display: flex; flex-direction: column; gap: 2px; min-height: 230px; }
  .segs :global(.seg) {
    display: flex; align-items: baseline; gap: 12px; width: 100%; padding: 10px; border: 0; border-radius: 10px; cursor: pointer;
    text-align: left; font-size: 15px; color: var(--text-soft); background: transparent; transition: background-color 120ms ease-out;
  }
  .segs :global(.seg:hover) { background: var(--surface-2); }
  .segs :global(.seg.playing) { background: rgba(212, 255, 63, 0.07); }
  .segs :global(.ts) { flex-shrink: 0; width: 38px; font-size: 12px; font-weight: 600; color: var(--info); }
  .segs :global(mark) { background: rgba(212, 255, 63, 0.24); color: var(--beam-hover); border-radius: 3px; padding: 0 2px; }
  .segs :global(.blank) { color: var(--sensitive); letter-spacing: 1px; }
  .segs :global(.empty) { padding: 40px 10px; text-align: center; font-size: 14px; color: var(--text-2); }
  @media (prefers-reduced-motion: reduce) { .frame { transition: none; } .segs :global(.seg) { transition: none; } }
</style>

<script>
  import { lines, total, fmt } from './recording-data';
  import { reducedMotion } from '../../lib/thumb';

  const root = document.querySelector<HTMLElement>('[data-recs]');
  if (root) {
    const reduced = reducedMotion();
    const scrub = root.querySelector<HTMLElement>('[data-scrub]')!;
    const frames = [...scrub.querySelectorAll<HTMLElement>('.frame')];
    const prog = root.querySelector<HTMLElement>('[data-prog]')!;
    const dur = root.querySelector<HTMLElement>('[data-dur]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const q = root.querySelector<HTMLInputElement>('[data-q]')!;
    const segs = root.querySelector<HTMLElement>('[data-segs]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    let timer: number | undefined;
    let at = 0;

    function show(sec: number) {
      at = Math.max(0, Math.min(total, sec));
      const i = Math.min(frames.length - 1, Math.floor((at / total) * frames.length));
      frames.forEach((f, j) => f.classList.toggle('on', j === i));
      prog.style.width = `${(at / total) * 100}%`;
      dur.textContent = fmt(at);
      scrub.setAttribute('aria-valuenow', String(Math.round(at)));
      scrub.setAttribute('aria-valuetext', fmt(at));
    }
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };

    scrub.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      stop();
      const r = scrub.getBoundingClientRect();
      show(((e.clientX - r.left) / r.width) * total);
      hint.textContent = 'Looking through it. Search on the right to jump to a line.';
    });
    // Touch: drag across it.
    scrub.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch') return;
      stop();
      const r = scrub.getBoundingClientRect();
      show(((e.clientX - r.left) / r.width) * total);
    });
    scrub.addEventListener('pointerleave', () => { if (!timer) { show(0); dur.textContent = fmt(total); } });
    scrub.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' || e.key === 'ArrowUp' ? 3 : e.key === 'ArrowLeft' || e.key === 'ArrowDown' ? -3 : 0;
      if (e.key === 'Home') { e.preventDefault(); stop(); show(0); return; }
      if (e.key === 'End') { e.preventDefault(); stop(); show(total); return; }
      if (!d) return;
      e.preventDefault();
      stop();
      show(at + d);
    });

    function play(from: number, row: HTMLElement) {
      stop();
      segs.querySelectorAll('.seg').forEach((x) => x.classList.toggle('playing', x === row));
      show(from);
      hint.textContent = `Playing from ${fmt(from)}, where it was said.`;
      if (reduced) return;
      timer = window.setInterval(() => {
        if (at >= total) { stop(); return; }
        show(at + 0.5);
      }, 250);
    }

    function row(l: (typeof lines)[number], term: string): HTMLButtonElement {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'seg';
      b.append(Object.assign(document.createElement('span'), { className: 'ts mono', textContent: fmt(l.t) }));
      const text = document.createElement('span');
      const i = term ? l.s.toLowerCase().indexOf(term) : -1;
      if (i >= 0) text.append(l.s.slice(0, i), Object.assign(document.createElement('mark'), { textContent: l.s.slice(i, i + term.length) }), l.s.slice(i + term.length));
      else text.append(l.s);
      if (l.code) {
        const blank = Object.assign(document.createElement('span'), { className: 'blank', textContent: '••••••' });
        blank.setAttribute('aria-label', 'code hidden');
        text.append(' ', blank);
      }
      b.append(text);
      b.addEventListener('click', () => play(l.t, b));
      return b;
    }

    function update() {
      const raw = q.value.trim();
      const term = raw.toLowerCase();
      const hits = term ? lines.filter((l) => l.s.toLowerCase().includes(term) || (l.code && 'code'.startsWith(term))) : lines;
      count.textContent = term ? `${hits.length} said` : `Speech · ${lines.length} lines`;
      segs.replaceChildren(
        ...(hits.length
          ? hits.map((l) => {
              const el = row(l, term);
              if (term && !reduced) el.classList.add('sl-pop');
              return el;
            })
          : [Object.assign(document.createElement('div'), { className: 'empty', textContent: `Nobody said “${raw}” in this recording.` })]),
      );
    }

    segs.querySelectorAll<HTMLButtonElement>('.seg').forEach((b) => b.addEventListener('click', () => play(Number(b.dataset.t), b)));
    q.addEventListener('input', update);
  }
</script>
