---
// Library › Duplicates: one set of retakes, "Keep" picked for you (the latest retake). K keeps another one,
// ⌘↩ "Keep best, trash 2", ⌘Z undoes. Same keys as the app.
const shots = [
  { n: 'Stripe – Payouts 9.41.02.png', t: '9:41 · first take', w: 70 },
  { n: 'Stripe – Payouts 9.41.20.png', t: '9:41 · cursor moved', w: 64 },
  { n: 'Stripe – Payouts 9.42.05.png', t: '9:42 · latest retake', w: 58 },
];
const keeper = 2;
---
<section id="duplicates" data-section="duplicates" class="wrap section split" aria-labelledby="dups-title" data-dups>
  <div class="window panel shadow-xl">
    <div class="titlebar">
      <span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
      <b>Library › Duplicates</b>
      <span class="sets">3 sets</span>
    </div>
    <div class="set">
      <div class="set-head"><span>Retakes · same page and words · minutes apart</span><span data-setcount>3 shots</span></div>
      <div class="cards" role="group" aria-label="Retakes of the same screenshot. Pick the one to keep.">
        {shots.map((s, i) => (
          <button type="button" class:list={['card', { keep: i === keeper }]} data-card={i} aria-pressed={String(i === keeper)}>
            <span class="shot" aria-hidden="true"><span class="l1"></span><span></span><span class="hl"></span><span style={`width: ${s.w}%`}></span></span>
            <span class="badge" aria-hidden="true">Keep</span>
            <span class="name mono">{s.n}</span>
            <span class="t">{s.t}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="foot">
      <span class="hint" data-hint aria-live="polite">Keep is picked for you. Press K to keep another one.</span>
      <span class="actions">
        <button type="button" class="btn btn-ghost btn-sm" data-undo disabled>Undo <kbd class="keycap">⌘Z</kbd></button>
        <button type="button" class="btn btn-beam btn-sm" data-go>Keep best, trash 2 <kbd class="keycap dark">⌘↩</kbd></button>
      </span>
    </div>
  </div>
  <div class="copy">
    <span class="eyebrow">Duplicates</span>
    <h2 class="h2" id="dups-title">Five tries at the same shot? Keep one.</h2>
    <p class="lede">Shotlight finds exact copies and retakes: nearly the same picture and words, taken minutes apart. It picks one to keep, you clear the rest, and Undo is one key away.</p>
    <div class="stat">
      <b data-stat>0</b>
      <span>duplicates removed this week</span>
    </div>
  </div>
</section>

<style>
  .window { flex: 1.3 1 520px; min-width: 0; display: flex; flex-direction: column; overflow: hidden; }
  .titlebar {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px; flex-wrap: wrap;
    border-bottom: 1px solid #24242C; background: #16161B;
  }
  .titlebar b { font-size: 13px; }
  .sets { font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 6px; background: var(--surface-3); color: var(--text-2); }
  .lights { display: flex; gap: 7px; }
  .lights span { width: 11px; height: 11px; border-radius: 50%; background: #FF5F57; }
  .lights span:nth-child(2) { background: #FEBC2E; }
  .lights span:nth-child(3) { background: #28C840; }
  .set { display: flex; flex-direction: column; gap: 12px; padding: 16px; }
  .set-head { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; font-size: 12px; color: var(--text-3); }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .card {
    position: relative; display: flex; flex-direction: column; gap: 8px; padding: 8px; border-radius: 12px; cursor: pointer;
    text-align: left; color: var(--text); background: var(--surface); border: 1px solid var(--line);
    transition: opacity 260ms ease-out, transform 260ms ease-out, border-color 160ms ease-out, background-color 160ms ease-out;
  }
  .card:hover { border-color: var(--line-strong); }
  .card.keep { border-color: var(--beam); background: rgba(212, 255, 63, 0.07); }
  .card.gone { opacity: 0.18; transform: scale(0.94); cursor: default; }
  .shot { height: 78px; border-radius: 7px; background: #F7F7F9; padding: 10px; display: flex; flex-direction: column; gap: 6px; overflow: hidden; }
  .shot span { display: block; height: 6px; border-radius: 2px; background: #C9C9D2; width: 85%; }
  .shot .l1 { width: 60%; height: 9px; background: #1E1E24; }
  .shot .hl { width: 45%; background: #635BFF; }
  .badge {
    position: absolute; top: 13px; right: 13px; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 6px;
    background: var(--beam); color: var(--bg); opacity: 0; transform: scale(0.8); transition: opacity 160ms ease-out, transform 160ms ease-out;
  }
  .card.keep .badge { opacity: 1; transform: none; }
  .name { font-size: 11.5px; color: var(--text-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .t { font-size: 11.5px; color: var(--text-4); }
  .foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 16px; border-top: 1px solid #24242C; flex-wrap: wrap; }
  .hint { font-size: 12px; color: var(--text-2); min-width: 0; }
  .actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .actions .btn[disabled] { opacity: 0.45; cursor: default; filter: none; transform: none; }
  .keycap.dark { background: rgba(0, 0, 0, 0.12); border-color: rgba(0, 0, 0, 0.3); color: var(--bg); }
  .copy { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .stat { display: flex; flex-direction: column; }
  .stat b { font-size: 32px; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .stat span { font-size: 13px; color: var(--text-3); }
  @media (max-width: 640px) {
    .copy { order: -1; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .card:nth-child(3) { grid-column: span 2; }
  }
  @media (prefers-reduced-motion: reduce) { .card, .badge { transition: none; } .card.gone { transform: none; } }
</style>

<script>
  import { reducedMotion } from '../../lib/thumb';

  const root = document.querySelector<HTMLElement>('[data-dups]');
  if (root) {
    const reduced = reducedMotion();
    const cards = [...root.querySelectorAll<HTMLButtonElement>('[data-card]')];
    const go = root.querySelector<HTMLButtonElement>('[data-go]')!;
    const undo = root.querySelector<HTMLButtonElement>('[data-undo]')!;
    const stat = root.querySelector<HTMLElement>('[data-stat]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const setCount = root.querySelector<HTMLElement>('[data-setcount]')!;
    const picked = 2;
    let keep = picked;
    let gone = false;
    let removed = 0;

    const pop = (el: HTMLElement) => {
      if (reduced) return;
      el.classList.remove('sl-pop');
      void el.offsetWidth;
      el.classList.add('sl-pop');
    };

    function render() {
      cards.forEach((c, i) => {
        c.classList.toggle('keep', i === keep);
        c.classList.toggle('gone', gone && i !== keep);
        c.setAttribute('aria-pressed', String(i === keep));
        c.disabled = gone;
      });
      go.disabled = gone;
      undo.disabled = !gone;
      stat.textContent = String(removed);
      setCount.textContent = gone ? '1 shot · 2 in the Trash' : '3 shots';
      hint.textContent = gone
        ? 'Moved 2 to the Trash. ⌘Z puts them back.'
        : keep === picked ? 'Keep is picked for you. Press K to keep another one.' : 'Keeping this one instead.';
    }

    const trash = () => { if (gone) return; gone = true; removed += 2; render(); pop(stat); undo.focus(); };
    const restore = () => { if (!gone) return; gone = false; removed = Math.max(0, removed - 2); render(); pop(stat); go.focus(); };

    cards.forEach((c, i) => c.addEventListener('click', () => { if (!gone) { keep = i; render(); } }));
    go.addEventListener('click', trash);
    undo.addEventListener('click', restore);
    // Keys work while focus is anywhere inside the demo (no global shortcuts on the page).
    root.addEventListener('keydown', (e) => {
      const cmd = e.metaKey || e.ctrlKey;
      if (!cmd && (e.key === 'k' || e.key === 'K') && !gone) {
        const focused = cards.indexOf(document.activeElement as HTMLButtonElement);
        keep = focused >= 0 && focused !== keep ? focused : (keep + 1) % cards.length;
        render();
      } else if (cmd && e.key === 'Enter') {
        e.preventDefault();
        trash();
      } else if (cmd && (e.key === 'z' || e.key === 'Z') && gone) {
        e.preventDefault();
        restore();
      }
    });
  }
</script>
