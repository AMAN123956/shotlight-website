---
// Small stroke icons used across the site (24 px grid, drawn with currentColor).
interface Props { name: 'check' | 'search' | 'arrow' | 'download' | 'lock' | 'arrow-down' | 'info'; class?: string }
const { name, class: cls = 'ic' } = Astro.props;
const paths: Record<string, string> = {
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-down': '<path d="M12 5v14M6 13l6 6 6-6"/>',
  download: '<path d="M12 4v11M7 11l5 5 5-5M5 20h14"/>',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v5h1"/>',
};
---
<svg class={cls} viewBox="0 0 24 24" aria-hidden="true" set:html={paths[name]}></svg>
