---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="wrap nf">
    <div class="names">
      <span class="old mono">Screenshot 2026-11-13 at 4.04.04 PM.png</span>
      <span class="new mono sl-scan">Page not found – 404.png</span>
    </div>
    <h1>This page isn’t here.</h1>
    <p class="lede">The link may be old, or the page moved. Everything else is where you left it.</p>
    <div class="actions">
      <a href="/" class="btn btn-beam btn-lg">Go to the home page</a>
      <a href="/download" class="btn btn-ghost btn-lg">Download</a>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 64vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 22px; padding-top: 80px; padding-bottom: 96px; }
  .names { display: flex; flex-direction: column; gap: 6px; align-items: center; padding: 14px 18px; border-radius: 14px; background: var(--card); border: 1px solid var(--line); max-width: 100%; }
  .old { font-size: 14px; color: var(--text-4); text-decoration: line-through; overflow-wrap: anywhere; }
  .new { font-size: 16px; font-weight: 500; overflow-wrap: anywhere; padding: 0 4px; border-radius: 4px; }
  h1 { font-size: clamp(36px, 5vw, 60px); line-height: 1.04; letter-spacing: -0.04em; font-weight: 600; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
</style>
