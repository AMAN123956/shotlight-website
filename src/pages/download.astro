---
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import DownloadButton from '../components/DownloadButton.astro';
import Icon from '../components/Icon.astro';
import release from '../data/release.json';
import { DOWNLOAD_LATEST, RELEASES_PAGE, BUY_ME_A_COFFEE } from '../lib/links';

const date = new Date(release.date + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const quarantine = 'xattr -dr com.apple.quarantine /Applications/Shotlight.app';
---
<Base title="Download" description={`Download Shotlight ${release.version} for Mac. Free, on-device, no account. macOS ${release.minMacOS} or later, ${release.arch}.`}>
  <div class="blob b-lime" style="width:560px;height:340px;left:-140px;top:60px;opacity:.75"></div>
  <div class="blob b-peach" style="width:520px;height:340px;right:-120px;top:40px;opacity:.7"></div>

  <section class="wrap-s top center">
    <span class="pill">Version {release.version}</span>
    <h1 class="display">Download <span class="serif">Shotlight.</span></h1>
    <p class="lead">Free for Mac while in early access. No account, and nothing leaves your Mac.</p>
  </section>

  <section class="wrap card-wrap">
    <div class="card dl">
      <AppIcon size={96} id="dl" />
      <div class="stack info">
        <h2 class="h3" style="font-size:28px">Shotlight {release.version}</h2>
        <p class="muted">Released {date} · {release.sizeMB} MB · .dmg · macOS {release.minMacOS} or later · {release.arch} (M1 or newer)</p>
        <p class="small mono muted sha"><span>SHA-256</span> <code data-sha>{release.sha256}</code> <button type="button" class="copy" data-copy={release.sha256} aria-label="Copy SHA-256" data-track="copy_sha256">Copy</button></p>
      </div>
      <div class="stack actions">
        <DownloadButton where="download" label="Download .dmg" />
        <a class="small center" href={RELEASES_PAGE} data-track="download_all_versions">All versions on GitHub</a>
      </div>
    </div>
    <p class="started" data-started hidden role="status"><Icon name="check" class="ic ic-sm ic-ok" /> Download started. Here is how to open it the first time.</p>
    <p class="started" data-arrived hidden role="status"><Icon name="check" class="ic ic-sm ic-ok" /> Your download should have started. If nothing happened, <a href={DOWNLOAD_LATEST} data-download data-after="none" data-where="download_retry" data-track="download_dmg">download it again</a>.</p>
  </section>

  {!release.signed && (
    <section id="first-open" class="sec wrap" data-section="first_open">
      <div class="sec-head" style="margin-bottom:36px">
        <span class="pill">Opening it the first time</span>
        <h2 class="h2">Four steps, <span class="serif">once per version.</span></h2>
        <p class="lead">This build is not signed by Apple yet. Apple only vouches for apps from developers in its paid program, and Shotlight has not joined it, so macOS asks you to confirm that you trust it. These steps go away once it is signed.</p>
      </div>

      <ol class="steps">
        <li class="step">
          <div class="art" aria-hidden="true">
            <div class="dmg">
              <div class="dmg-bar"><span class="lights"><span></span><span></span><span></span></span><span>Shotlight</span></div>
              <div class="dmg-body">
                <span class="dmg-item"><AppIcon size={44} id="dmg" /><span>Shotlight</span></span>
                <svg class="drag" width="56" height="16" viewBox="0 0 60 16" fill="none" stroke="#D4FF3F" stroke-width="2" stroke-linecap="round"><path d="M2 8h54M48 2l8 6-8 6"></path></svg>
                <span class="dmg-item"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#7CC4FF" stroke-width="1.4" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"></path></svg><span>Applications</span></span>
              </div>
            </div>
          </div>
          <span class="num">1</span>
          <h3>Drag Shotlight to Applications</h3>
          <p>Open the downloaded <code class="mono">Shotlight-{release.version}.dmg</code> and drag the app onto the Applications folder.</p>
        </li>
        <li class="step">
          <div class="art" aria-hidden="true">
            <div class="alert">
              <AppIcon size={28} id="alert" />
              <b>“Shotlight” Not Opened</b>
              <span>Apple could not verify “Shotlight” is free of malware that may harm your Mac or compromise your privacy.</span>
              <span class="alert-btns"><span class="ab hot">Done</span><span class="ab">Move to Trash</span></span>
            </div>
          </div>
          <span class="num">2</span>
          <h3>Open it, then click Done</h3>
          <p>macOS says it can’t verify the app. Click <strong>Done</strong>, not Move to Trash.</p>
        </li>
        <li class="step">
          <div class="art" aria-hidden="true">
            <div class="settings">
              <span class="settings-title">Privacy &amp; Security</span>
              <span class="settings-sec">Security</span>
              <span class="settings-row"><span>“Shotlight” was blocked to protect your Mac.</span><span class="ab hot">Open Anyway</span></span>
            </div>
          </div>
          <span class="num">3</span>
          <h3>Click Open Anyway</h3>
          <p>Open <strong>System Settings › Privacy &amp; Security</strong>, scroll down to Security, click <strong>Open Anyway</strong> next to Shotlight, and confirm with your password.</p>
        </li>
        <li class="step">
          <div class="art" aria-hidden="true">
            <div class="menubar">
              <div class="mb-icons"><span class="mb-shot"><AppIcon size={14} id="mb" /></span><span>Wi‑Fi</span><span>9:41</span></div>
              <div class="mb-pop">Setup · 3 steps</div>
            </div>
          </div>
          <span class="num">4</span>
          <h3>Shotlight starts in the menu bar</h3>
          <p>It shows a short setup: pick the folder with your screenshots and a naming style. After that, take a screenshot and it names itself.</p>
        </li>
      </ol>

      <div class="extra">
        <h3>Prefer Terminal?</h3>
        <p class="muted">After step 1, this removes the quarantine flag, so macOS skips the warning. It repeats for each new version.</p>
        <div class="cmd"><code class="mono">{quarantine}</code><button type="button" class="copy" data-copy={quarantine} aria-label="Copy command" data-track="copy_quarantine">Copy</button></div>
        <p class="small muted">macOS may also ask for access to your screenshot folder again after an update. That goes away once the app is signed.</p>
      </div>
    </section>
  )}

  <section class="wrap sec-s coffee-row">
    <div class="card support">
      <div class="stack">
        <h2 class="h3" style="font-size:22px">Enjoying Shotlight?</h2>
        <p class="muted">It is made by one person and free while in early access. If it saves you time, a coffee helps me keep going.</p>
      </div>
      <a class="coffee" href={BUY_ME_A_COFFEE} data-track="download_coffee"><img src="/bmc-button.png" alt="Buy me a coffee" width="136" height="38" decoding="async" /></a>
    </div>
  </section>

  <section class="wrap sec-s more">
    <div class="steps3 two">
      <div class="card stack" style="gap:12px"><span class="tag t-find" style="align-self:flex-start">Verify</span><h3 class="h3">Check the download</h3><p class="muted">Compare the SHA-256 above with your file, and see how to confirm the app never goes online.</p><a href="/verify" data-track="download_verify">How to verify it</a></div>
      <div class="card stack" style="gap:12px"><span class="tag t-name" style="align-self:flex-start">Homebrew</span><h3 class="h3">Install from Terminal</h3><p class="muted">A Homebrew install is coming. The tap is not published yet, so there is no command to run today.</p></div>
    </div>
  </section>
</Base>

<style>
  .top { padding-top: 84px; position: relative; z-index: 1; }
  .top h1 { font-size: clamp(42px, 5.4vw, 72px); margin-top: 24px; }
  .top .lead { margin: 22px auto 0; max-width: 560px; }
  .card-wrap { max-width: 980px; padding-top: 48px; position: relative; z-index: 1; }
  .dl { padding: 40px; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 32px; align-items: center; border-radius: 40px; }
  .info { gap: 6px; }
  .sha { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 6px; }
  .sha code { overflow-wrap: anywhere; font-size: 12px; }
  .actions { gap: 12px; align-items: stretch; }
  .copy { padding: 4px 10px; border-radius: 8px; border: 1px solid var(--line-strong); background: #fff; font: 500 12px var(--sans); cursor: pointer; transition: border-color 120ms ease-out; }
  .copy:hover { border-color: var(--text-3); }
  .started { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 18px; padding: 12px 16px; border-radius: 16px; background: var(--beam-tint); border: 1px solid rgba(77, 107, 0, 0.28); font-size: 15px; color: var(--text); }
  .started[hidden] { display: none; }

  #first-open .sec-head { scroll-margin-top: 96px; }
  #first-open.is-flash .steps { animation: flash 1.6s ease-out; }
  @keyframes flash { 0% { box-shadow: 0 0 0 0 rgba(212, 255, 63, 0.9); } 100% { box-shadow: 0 0 0 28px rgba(212, 255, 63, 0); } }
  #first-open h2:focus { outline: none; }
  .steps { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; border-radius: 28px; }
  .step { display: flex; flex-direction: column; gap: 14px; padding: 20px; border-radius: 24px; background: rgba(255, 255, 255, 0.74); border: 1px solid var(--line); }
  .step h3 { font-size: 18px; letter-spacing: -0.02em; }
  .step p { font-size: 14.5px; line-height: 1.55; color: var(--text-3); }
  .step p strong { color: var(--text); font-weight: 600; }
  .step code { font-size: 12px; color: var(--text-2); overflow-wrap: anywhere; }
  .art { height: 196px; border-radius: 16px; background: var(--surface-2); display: flex; align-items: center; justify-content: center; padding: 12px; overflow: hidden; }

  /* macOS mockups stay dark: that is how they look */
  .dmg { width: 100%; max-width: 230px; border-radius: 10px; background: #1F1F26; border: 1px solid #3A3A44; overflow: hidden; color: #F4F4F6; }
  .dmg-bar { display: flex; align-items: center; gap: 10px; padding: 6px 8px; font-size: 11px; color: #A6A6B3; border-bottom: 1px solid #2A2A33; }
  .lights { display: flex; gap: 5px; }
  .lights span { width: 8px; height: 8px; border-radius: 50%; background: #FF5F57; }
  .lights span:nth-child(2) { background: #FEBC2E; } .lights span:nth-child(3) { background: #28C840; }
  .dmg-body { display: flex; align-items: center; justify-content: space-around; padding: 16px 8px; }
  .dmg-item { display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: 11px; }
  .alert { width: 100%; max-width: 230px; display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; padding: 10px 12px; border-radius: 14px; background: #2A2A31; border: 1px solid #3A3A44; font-size: 10px; line-height: 1.35; color: #A6A6B3; }
  .alert b { font-size: 12px; color: #F4F4F6; }
  .alert-btns { display: flex; flex-direction: column; gap: 5px; width: 100%; margin-top: 4px; }
  .ab { display: block; padding: 4px 8px; border-radius: 6px; background: #3A3A44; color: #F4F4F6; font-size: 11px; font-weight: 500; }
  .ab.hot { background: var(--beam); color: var(--ink); box-shadow: 0 0 0 3px rgba(212, 255, 63, 0.3); }
  .settings { width: 100%; max-width: 240px; border-radius: 10px; background: #1F1F26; border: 1px solid #3A3A44; padding: 10px; display: flex; flex-direction: column; gap: 8px; color: #F4F4F6; }
  .settings-title { font-size: 12px; font-weight: 600; }
  .settings-sec { font-size: 10px; color: #A6A6B3; text-transform: uppercase; letter-spacing: 0.05em; }
  .settings-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px; border-radius: 8px; background: #2A2A31; font-size: 10px; color: #D8D8DE; }
  .settings-row .ab { white-space: nowrap; flex-shrink: 0; }
  .menubar { position: relative; width: 100%; max-width: 240px; height: 120px; border-radius: 10px; overflow: hidden; background: radial-gradient(300px 160px at 20% 100%, #3A2E5C 0%, rgba(58, 46, 92, 0) 70%), #15161C; border: 1px solid #2A2A33; color: #E4E4EA; }
  .mb-icons { display: flex; justify-content: flex-end; align-items: center; gap: 10px; height: 22px; padding: 0 8px; background: rgba(12, 12, 16, 0.6); font-size: 10px; }
  .mb-shot { display: inline-flex; width: 24px; height: 16px; align-items: center; justify-content: center; border-radius: 4px; background: rgba(212, 255, 63, 0.35); }
  .mb-pop { position: absolute; right: 30px; top: 30px; padding: 8px 10px; border-radius: 10px; background: rgba(28, 28, 34, 0.95); border: 1px solid #3A3A44; font-size: 11px; font-weight: 500; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.4); }

  .extra { margin-top: 32px; max-width: 760px; display: flex; flex-direction: column; gap: 10px; }
  .cmd { display: flex; align-items: center; gap: 10px; padding: 12px 12px 12px 16px; border-radius: 14px; background: var(--app); color: #F4F4F6; overflow-x: auto; }
  .cmd code { flex: 1; min-width: 0; font-size: 13px; white-space: nowrap; }
  .cmd .copy { background: #26262d; border-color: #3a3a44; color: #F4F4F6; flex-shrink: 0; }

  .coffee-row { max-width: 980px; }
  .support { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px; padding: 28px 32px; }
  .support .stack { gap: 6px; max-width: 560px; }
  .coffee { display: inline-flex; border-radius: 10px; transition: transform 120ms ease-out, filter 120ms ease-out; }
  .coffee img { height: 44px; width: auto; border-radius: 10px; }
  .coffee:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .more { max-width: 980px; padding-bottom: 112px; }
  .two { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  @media (max-width: 980px) { .dl { grid-template-columns: minmax(0, 1fr); padding: 28px 22px; gap: 22px; } .two { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { .top { padding-top: 56px; } }
  @media (prefers-reduced-motion: reduce) { #first-open.is-flash .steps { animation: none; } .copy, .coffee { transition: none; } .coffee:hover { transform: none; } }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = 'Copied';
      } catch {
        b.textContent = 'Select and copy';
      }
      window.setTimeout(() => { b.textContent = 'Copy'; }, 1600);
    });
  });
</script>
