---
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import MenuGlyph from '../components/MenuGlyph.astro';
import release from '../data/release.json';
import { DOWNLOAD_LATEST, RELEASES_PAGE } from '../lib/links';

const date = new Date(release.date + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const quarantine = 'xattr -dr com.apple.quarantine /Applications/Shotlight.app';
---
<Base title="Download" description={`Download Shotlight ${release.version} for Mac. Free, on-device, no account. macOS ${release.minMacOS} or later, ${release.arch}.`}>
  <section class="wrap top">
    <div class="intro">
      <span class="eyebrow">Download</span>
      <h1>Shotlight for Mac</h1>
      <p class="meta">
        Version {release.version} · {date} · {release.sizeMB} MB<br />
        macOS {release.minMacOS} or later · {release.arch}
      </p>
      <div class="actions">
        <a href={DOWNLOAD_LATEST} class="btn btn-beam btn-lg" data-download>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 10l6 6 6-6M5 20h14"></path></svg>
          Download Shotlight {release.version}
        </a>
        <a href="/changelog" class="btn btn-ghost btn-lg">What’s new</a>
      </div>
      <p class="started" data-started hidden role="status">Downloading. Next: <a href="#first-open">open it the first time</a> (one extra step).</p>
      <p class="privacy-line">Free while in early access. No account, and Shotlight never connects to the internet.</p>
    </div>
    <div class="facts panel">
      <div class="fact"><span>Requires</span><b>macOS {release.minMacOS} or later</b></div>
      <div class="fact"><span>Chip</span><b>{release.arch} (M1 or newer)</b></div>
      <div class="fact"><span>Best with</span><b>macOS 26 + Apple Intelligence</b></div>
      <div class="fact sha">
        <span>SHA-256</span>
        <span class="sha-row">
          <code class="mono" data-sha>{release.sha256}</code>
          <button type="button" class="copy" data-copy={release.sha256} aria-label="Copy SHA-256">Copy</button>
        </span>
      </div>
      <a class="all" href={RELEASES_PAGE}>All versions on GitHub</a>
    </div>
  </section>

  <section id="first-open" class="band">
    <div class="wrap section">
      <div class="head">
        <span class="eyebrow">Opening it the first time</span>
        <h2 class="h2">One extra step.</h2>
        <p class="lede">This early build isn’t signed by Apple yet. Apple only vouches for apps from developers in its paid program, and Shotlight hasn’t joined yet, so macOS asks you to confirm that you trust it.</p>
      </div>

      <ol class="steps">
        <li class="step">
          <div class="art" aria-hidden="true">
            <div class="dmg">
              <div class="dmg-bar"><span class="lights"><span></span><span></span><span></span></span><span>Shotlight</span></div>
              <div class="dmg-body">
                <span class="dmg-item"><AppIcon size={44} id="dmg" /><span>Shotlight</span></span>
                <svg class="drag" width="56" height="16" viewBox="0 0 60 16" fill="none" stroke="#D4FF3F" stroke-width="2" stroke-linecap="round"><path d="M2 8h54M48 2l8 6-8 6"></path></svg>
                <span class="dmg-item"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#7CC4FF" stroke-width="1.4" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"></path></svg><span>Applications</span></span>
              </div>
            </div>
          </div>
          <span class="num">01</span>
          <b>Drag Shotlight to Applications</b>
          <span class="body">Open the downloaded <code class="mono">Shotlight-{release.version}.dmg</code> and drag the app onto the Applications folder.</span>
        </li>
        <li class="step">
          <div class="art" aria-hidden="true">
            <div class="alert">
              <AppIcon size={28} id="alert" />
              <b>“Shotlight” Not Opened</b>
              <span>Apple could not verify “Shotlight” is free of malware that may harm your Mac or compromise your privacy.</span>
              <span class="alert-btns"><span class="ab hot">Done</span><span class="ab">Move to Trash</span></span>
            </div>
          </div>
          <span class="num">02</span>
          <b>Open it, then click Done</b>
          <span class="body">macOS says it can’t verify the app. Click <strong>Done</strong>, not Move to Trash.</span>
        </li>
        <li class="step">
          <div class="art" aria-hidden="true">
            <div class="settings">
              <div class="settings-title">Privacy &amp; Security</div>
              <div class="settings-sec">Security</div>
              <div class="settings-row">
                <span>“Shotlight” was blocked to protect your Mac.</span>
                <span class="ab hot">Open Anyway</span>
              </div>
            </div>
          </div>
          <span class="num">03</span>
          <b>Click Open Anyway in System Settings</b>
          <span class="body">Open <strong>System Settings › Privacy &amp; Security</strong>, scroll down to Security, click <strong>Open Anyway</strong> next to Shotlight, and confirm with your password.</span>
        </li>
        <li class="step">
          <div class="art" aria-hidden="true">
            <div class="menubar">
              <span class="mb-icons">
                <span class="mb-shot"><MenuGlyph /></span>
                <span>Thu 9:41 PM</span>
              </span>
              <span class="mb-pop">Welcome to Shotlight</span>
            </div>
          </div>
          <span class="num">04</span>
          <b>That’s it</b>
          <span class="body">Shotlight appears in the menu bar and walks you through a short setup. From now on it opens normally.</span>
        </li>
      </ol>

      <div class="extra prose">
        <h3>Good to know</h3>
        <ul>
          <li>You do this once per version. After an update, macOS may also ask again for access to your Desktop. Both go away once Shotlight is signed by Apple.</li>
          <li>
            Prefer Terminal? After step 1, this does the same as steps 2 and 3:
            <span class="cmd"><code data-cmd>{quarantine}</code><button type="button" class="copy" data-copy={quarantine} aria-label="Copy Terminal command">Copy</button></span>
          </li>
          <li>To check the download, run <code>shasum -a 256 ~/Downloads/Shotlight.dmg</code> and compare it with the SHA-256 above.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap section updates">
    <div class="prose narrow">
      <h2>Updating</h2>
      <p>Shotlight never checks for updates by itself, because it never goes online. To update, download the latest version here and replace the app in Applications. Your names, search index and settings stay as they are. New versions are listed in the <a href="/changelog">changelog</a>.</p>
      <h2>Uninstalling</h2>
      <p>Quit Shotlight from its menu, then move it from Applications to the Trash. To remove its search index too, delete <code>~/Library/Application Support/Shotlight</code>. Your screenshots keep their new names.</p>
    </div>
  </section>
</Base>

<style>
  .top { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; padding-top: 80px; padding-bottom: 80px; }
  .intro { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  h1 { font-size: clamp(40px, 5vw, 64px); line-height: 1.02; letter-spacing: -0.045em; font-weight: 600; }
  .meta { font-size: 16px; line-height: 1.6; color: var(--text-2); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .started { font-size: 14px; color: var(--text); padding: 10px 14px; border-radius: 12px; background: rgba(212, 255, 63, 0.07); border: 1px solid rgba(212, 255, 63, 0.25); width: max-content; max-width: 100%; }
  .privacy-line { font-size: 13px; color: var(--text-3); }
  .facts { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; padding: 8px 24px 20px; }
  .fact { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .fact > span:first-child { color: var(--text-3); }
  .fact b { font-weight: 500; text-align: right; }
  .sha { flex-direction: column; gap: 8px; }
  .sha-row, .cmd { display: flex; align-items: center; gap: 10px; }
  .sha code { font-size: 12px; color: var(--text-soft); overflow-wrap: anywhere; line-height: 1.5; }
  .copy {
    flex-shrink: 0; height: 28px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--surface-3);
    color: var(--text); font-size: 12px; font-weight: 500; cursor: pointer; transition: border-color 120ms ease-out;
  }
  .copy:hover { border-color: var(--line-strong); }
  .all { margin-top: 16px; font-size: 14px; text-underline-offset: 3px; }

  .head { display: flex; flex-direction: column; gap: 14px; max-width: 720px; margin-bottom: 40px; }
  .steps { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; }
  .step { display: flex; flex-direction: column; gap: 14px; padding: 20px; border-radius: 20px; background: var(--card); border: 1px solid var(--line); }
  .step b { font-size: 17px; }
  .num { font: 600 13px var(--mono); color: var(--beam); }
  .body { font-size: 14px; line-height: 1.55; color: var(--text-2); }
  .body strong { color: var(--text); font-weight: 600; }
  .body code { font-size: 12px; color: var(--text-soft); overflow-wrap: anywhere; }
  .art { height: 196px; border-radius: 14px; background: var(--surface-2); display: flex; align-items: center; justify-content: center; padding: 12px; overflow: hidden; }

  .dmg { width: 100%; max-width: 230px; border-radius: 10px; background: #1F1F26; border: 1px solid var(--line-strong); overflow: hidden; }
  .dmg-bar { display: flex; align-items: center; gap: 10px; padding: 6px 8px; font-size: 11px; color: var(--text-2); border-bottom: 1px solid var(--line); }
  .lights { display: flex; gap: 5px; }
  .lights span { width: 8px; height: 8px; border-radius: 50%; background: #FF5F57; }
  .lights span:nth-child(2) { background: #FEBC2E; }
  .lights span:nth-child(3) { background: #28C840; }
  .dmg-body { display: flex; align-items: center; justify-content: space-around; padding: 16px 8px; }
  .dmg-item { display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: 11px; }

  .alert {
    width: 100%; max-width: 230px; display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center;
    padding: 10px 12px; border-radius: 14px; background: #2A2A31; border: 1px solid #3A3A44; font-size: 10px; line-height: 1.35; color: var(--text-2);
  }
  .alert b { font-size: 12px; color: var(--text); }
  .alert-btns { display: flex; flex-direction: column; gap: 5px; width: 100%; margin-top: 4px; }
  .ab { display: block; padding: 4px 8px; border-radius: 6px; background: #3A3A44; color: var(--text); font-size: 11px; font-weight: 500; }
  .ab.hot { background: var(--beam); color: var(--bg); box-shadow: 0 0 0 3px rgba(212, 255, 63, 0.25); }

  .settings { width: 100%; max-width: 240px; border-radius: 10px; background: #1F1F26; border: 1px solid var(--line-strong); padding: 10px; display: flex; flex-direction: column; gap: 8px; }
  .settings-title { font-size: 12px; font-weight: 600; }
  .settings-sec { font-size: 10px; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.05em; }
  .settings-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px; border-radius: 8px; background: #2A2A31; font-size: 10px; color: var(--text-soft); }
  .settings-row .ab { white-space: nowrap; flex-shrink: 0; }

  .menubar { position: relative; width: 100%; max-width: 240px; height: 120px; border-radius: 10px; overflow: hidden; background: radial-gradient(300px 160px at 20% 100%, #3A2E5C 0%, rgba(58, 46, 92, 0) 70%), #15161C; border: 1px solid var(--line); }
  .mb-icons { display: flex; justify-content: flex-end; align-items: center; gap: 10px; height: 22px; padding: 0 8px; background: rgba(12, 12, 16, 0.6); font-size: 10px; color: #E4E4EA; }
  .mb-shot { display: inline-flex; width: 24px; height: 16px; align-items: center; justify-content: center; border-radius: 4px; background: rgba(212, 255, 63, 0.35); }
  .mb-pop { position: absolute; right: 30px; top: 30px; padding: 8px 10px; border-radius: 10px; background: rgba(28, 28, 34, 0.95); border: 1px solid var(--line-strong); font-size: 11px; font-weight: 500; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.4); }

  .extra { margin-top: 32px; max-width: 760px; }
  .extra h3 { margin-top: 0; }
  .cmd { margin-top: 8px; flex-wrap: wrap; }
  .narrow { max-width: 760px; }
  .updates .prose h2:first-child { margin-top: 0; }

  @media (max-width: 640px) {
    .top { padding-top: 48px; padding-bottom: 56px; gap: 32px; }
    .facts { padding: 4px 16px 16px; }
  }
</style>

<script>
  document.querySelector('[data-download]')?.addEventListener('click', () => {
    const note = document.querySelector<HTMLElement>('[data-started]');
    if (note) note.hidden = false;
  });
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = 'Copied';
      } catch {
        b.textContent = 'Select and copy';
      }
      window.setTimeout(() => { b.textContent = 'Copy'; }, 1600);
    });
  });
</script>
