---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Proof from '../components/home/Proof.astro';
import Features from '../components/home/Features.astro';
import PrivacySection from '../components/home/PrivacySection.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import GuidesTeaser from '../components/home/GuidesTeaser.astro';
import DownloadCard from '../components/home/DownloadCard.astro';
import Faq from '../components/home/Faq.astro';
import ClosingBand from '../components/home/ClosingBand.astro';
import release from '../data/release.json';
import { publishedGuides } from '../lib/content';
import { DOWNLOAD_LATEST } from '../lib/links';

const guides = await publishedGuides();
const site = (Astro.site ?? new URL('https://www.shotlight.lol')).href.replace(/\/$/, '');
const app = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Shotlight',
  description: 'A Mac app that names every screenshot the moment you take it and finds any of them by the words inside. Everything runs on your Mac.',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: `macOS ${release.minMacOS} or later`,
  softwareVersion: release.version,
  downloadUrl: DOWNLOAD_LATEST,
  url: site + '/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<Base path="/">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(app)}></script>
  <Hero />
  <Proof />
  <Features />
  <PrivacySection />
  <HowItWorks />
  <GuidesTeaser posts={guides} />
  <DownloadCard />
  <Faq />
  <ClosingBand />
</Base>
