---
import Base from '../layouts/Base.astro';
import Hero from '../components/landing/Hero.astro';
import Steps from '../components/landing/Steps.astro';
import Chapter from '../components/landing/Chapter.astro';
import Naming from '../components/landing/Naming.astro';
import Search from '../components/landing/Search.astro';
import Recordings from '../components/landing/Recordings.astro';
import Tidy from '../components/landing/Tidy.astro';
import Rules from '../components/landing/Rules.astro';
import Duplicates from '../components/landing/Duplicates.astro';
import AlsoNew from '../components/landing/AlsoNew.astro';
import Guard from '../components/landing/Guard.astro';
import Privacy from '../components/landing/Privacy.astro';
import Pricing from '../components/landing/Pricing.astro';
import Faq from '../components/landing/Faq.astro';
import FinalCta from '../components/landing/FinalCta.astro';
// Four chapters, a screenshot's life: Name → Find → Organize → Protect. Sections alternate band / plain
// (the .tone wrappers), so neighbours never share a background.
---
<Base path="/">
  <Hero />
  <Steps />

  <div class="tone tone-band" id="name">
    <Chapter current="name" />
    <Naming />
  </div>

  <div class="tone" id="find">
    <Chapter current="find" />
    <Search />
  </div>
  <div class="tone tone-band">
    <Recordings />
    <AlsoNew items={['spotlight']} label="Also new in 0.2" />
  </div>

  <div class="tone" id="organize">
    <Chapter current="organize" />
    <Tidy />
  </div>
  <div class="tone tone-band">
    <Rules />
  </div>
  <div class="tone">
    <Duplicates />
    <AlsoNew items={['folders', 'tags', 'week']} label="Also new in 0.2" />
  </div>

  <div class="tone tone-band" id="protect">
    <Chapter current="protect" />
    <Guard />
  </div>
  <div class="tone">
    <Privacy />
  </div>

  <Pricing />
  <Faq />
  <FinalCta />
</Base>
